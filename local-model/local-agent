#!/usr/bin/env python3
"""local-agent: hand a ticket to the local model, the way a senior hands one to a junior. For Claude sessions.

  local-agent <mode> <ticket.md|-> [--cwd DIR] [--write] [--timeout SECONDS (default 900)]

For bounded work only: tasks Claude can define precisely and the local model finishes in minutes. Not for what Claude
does in a minute itself (the ticket and the check would cost more), and not for open-ended work.

Modes: facts, evidence, reproduce, run, implement, cold-read. The result is one JSON object (schema per mode) on
stdout, plus an `id` and a `logs` folder; full output stays in the logs. Runs offline in the sandbox: no network, no
credentials, everything read-only except --cwd with --write (implement needs --write). It can't push or post; you
check the result and act.

Ticket (markdown, '## ' headings): Goal (one observable outcome; required), Facts (verified facts only, each with its
source), To check (hypotheses, phrased as questions), Scope (paths and commands allowed), Acceptance (commands or
observations that define done; required for implement and reproduce), Position (evidence mode: the side to argue),
File (cold-read: the file to read), Plan (implement: your key points, in order; the agent follows them and doesn't
choose its own approach). Opinions in Facts are refused: put a guess under To check, as a question.
"""
import json, os, re, subprocess, sys, uuid

DIR = os.path.dirname(os.path.realpath(__file__))
RUNS = os.path.expanduser('~/.cache/local-agent')

def obj(props, req=None):
    return {'type': 'object', 'properties': props, 'required': req or list(props)}
S, B, N = {'type': 'string'}, {'type': 'boolean'}, {'type': ['integer', 'null']}
def arr(item): return {'type': 'array', 'items': item}
CLAIM = obj({'claim': S, 'source': S, 'quote': S})          # source: path:line, or the command that showed it
CMD = obj({'command': S, 'exit_code': N, 'result': S})
NOT_CHECKED = arr(S)

MODES = {
  'facts': ('Answer the Goal with facts from the code and commands only.',
            obj({'answer': S, 'claims': arr(CLAIM), 'not_checked': NOT_CHECKED})),
  'evidence': ('Build the strongest evidence-backed case for the Position: what the code does (path:line), what main does '
               'for the analogous case, a measurement where one is possible. Also list the weakest points of this side.',
            obj({'position': S, 'case': S, 'evidence': arr(CLAIM), 'measurements': arr(CMD), 'weakest_points': arr(S),
                 'not_checked': NOT_CHECKED})),
  'reproduce': ('Reproduce what the Goal describes, exactly as written. Do not fix anything.',
            obj({'reproduced': B, 'steps': arr(CMD), 'expected_vs_actual': S, 'artifacts': arr(S), 'not_checked': NOT_CHECKED})),
  'run': ('Run what the Scope lists and report each result. Do not change files.',
            obj({'results': arr(CMD), 'not_checked': NOT_CHECKED})),
  'cold-read': ('Read the File as a newcomer would. Explain each section back in one line, and list every sentence you '
                'could not act on or understand, quoting it.',
            obj({'summary_back': arr(S), 'unclear': arr(obj({'quote': S, 'why': S}))})),
  'implement': ('Implement the Plan, step by step, then commit on the current branch and run every Acceptance check. '
                'The approach is the Plan\'s: if a step turns out wrong or impossible, stop and report it in deviations '
                'instead of choosing another approach.',
            obj({'commits': arr(obj({'sha': S, 'title': S})), 'diff_stat': S, 'acceptance': arr(CMD), 'deviations': arr(S),
                 'not_checked': NOT_CHECKED})),
}
OPINION = re.compile(r"\b(I think|I believe|probably|likely|I guess|my guess|seems to|should be|the fix is|the cause is|"
                     r"the bug is|obviously|clearly)\b", re.I)

def sections(text):
    out, cur = {}, None
    for line in text.splitlines():
        m = re.match(r'^##\s+(.+?)\s*$', line)
        if m: cur = m.group(1).strip().lower(); out[cur] = ''
        elif cur: out[cur] += line + '\n'
    return {k: v.strip() for k, v in out.items()}

def fail(msg): print(f'local-agent: {msg}', file=sys.stderr); sys.exit(2)

def run(run_dir, cwd, write, timeout, prompt, role, schema):
    os.makedirs(os.path.join(run_dir, 'gh-snapshot'), exist_ok=True)
    env = dict(os.environ, SANDBOX_WS=cwd, SANDBOX_CLAUDE_MD=os.path.join(DIR, 'delegate-instructions.md'), SANDBOX_NO_HOOKS='1')
    if not write: env['SANDBOX_WS_RO'] = '1'
    else: env.pop('SANDBOX_WS_RO', None)
    sid = str(uuid.uuid4())
    args = ['claude', '-p', prompt, '--permission-mode', 'bypassPermissions', '--strict-mcp-config', '--output-format', 'json',
            '--json-schema', json.dumps(schema), '--append-system-prompt', role,
            '--disallowedTools', 'Agent', 'Task']  # a ticket's agent is a subagent: it never starts its own
    args += ['--session-id', sid]
    with open(os.path.join(run_dir, 'stderr.log'), 'a') as err:
        p = subprocess.run([os.path.join(DIR, 'sandbox', 'sandbox'), run_dir, os.path.join(DIR, 'delegate-instructions.md'),
                            str(timeout), '--'] + args, env=env, stdout=subprocess.PIPE, stderr=err, stdin=subprocess.DEVNULL, text=True)
    open(os.path.join(run_dir, 'result.json'), 'w').write(p.stdout)
    try: d = json.loads(p.stdout)
    except Exception: return {'error': f'no result: timed out after {timeout // 60} min or crashed; see the logs'}
    out = d.get('structured_output')
    if isinstance(out, str):
        try: out = json.loads(out)
        except Exception: pass
    return out if out is not None else {'error': 'no structured result', 'text': (d.get('result') or '')[:2000]}

def main():
    a = sys.argv[1:]
    if not a or a[0] in ('-h', '--help'): print(__doc__); return
    mode = a[0]
    if mode not in MODES: fail(f'unknown mode {mode!r}; modes: {", ".join(MODES)}')
    if len(a) < 2: fail('a ticket file (or - for stdin) is required')
    ticket = sys.stdin.read() if a[1] == '-' else open(a[1]).read()
    opts = {'--cwd': os.getcwd(), '--timeout': '900'}; write = '--write' in a
    for i, x in enumerate(a):
        if x in opts and i + 1 < len(a): opts[x] = a[i + 1]
    sec = sections(ticket)
    if 'goal' not in sec: fail('the ticket needs a "## Goal"')
    if mode in ('implement', 'reproduce') and 'acceptance' not in sec: fail(f'{mode} needs a "## Acceptance"')
    if mode == 'implement' and 'plan' not in sec: fail('implement needs a "## Plan": your key points, in order')
    if mode == 'implement' and not write: fail('implement needs --write')
    if mode == 'evidence' and 'position' not in sec: fail('evidence needs a "## Position"')
    if mode == 'cold-read' and 'file' not in sec: fail('cold-read needs a "## File"')
    m = OPINION.search(sec.get('facts', ''))
    if m: fail(f'opinion in Facts ("{m.group(0)}"): facts only, each with its source; put a hypothesis under "## To check" as a question')
    cwd = os.path.realpath(opts['--cwd']); rid = f'{mode}-{uuid.uuid4().hex[:8]}'; run_dir = os.path.join(RUNS, rid)
    os.makedirs(run_dir, exist_ok=True)
    json.dump({'mode': mode, 'cwd': cwd, 'write': write, 'timeout': int(opts['--timeout'])}, open(os.path.join(run_dir, 'meta.json'), 'w'))
    open(os.path.join(run_dir, 'ticket.md'), 'w').write(ticket)
    role, schema = MODES[mode]
    access = 'read-write' if write else 'read-only'
    mins = int(opts['--timeout']) // 60
    prompt = f'{ticket}\n\n(You work in {cwd}, {access}. Offline: no internet; gh cannot reach GitHub. Time limit: {mins} minutes.)'
    res = run(run_dir, cwd, write, int(opts['--timeout']), prompt, role, schema)
    print(json.dumps({'id': rid, 'logs': run_dir, **res}, indent=1))

main()
