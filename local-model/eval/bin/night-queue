#!/usr/bin/env bash
# night-queue <jobs file>: runs each "task variant" line in turn (one GPU), skipping lines already in night.tsv;
# re-reads the file after each job, so lines appended meanwhile run too. Waits while another replay holds the GPU.
E="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"; J=$1
while :; do
  job=$(while read -r t v; do [ -n "$t" ] || continue; n=$(grep -c "^$t	$v	" "$E/night.tsv" 2>/dev/null); want=$(grep -c "^$t $v\$" "$J"); [ "$n" -lt "$want" ] && { echo "$t $v"; break; }; done < "$J")
  [ -n "$job" ] || break
  while [ -e "$E/.gpu-busy" ]; do sleep 30; done
  touch "$E/.gpu-busy"; "$E/bin/night-run" $job 3600; rm -f "$E/.gpu-busy"
done
echo "queue done"
