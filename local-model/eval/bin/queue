#!/usr/bin/env bash
# queue "<profile> <task> <arm>"...: run each sequentially (one GPU slot), one hour max each.
E="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
for job in "$@"; do set -- $job; echo "$(date +%T) start $job"; LLM_PROFILE=$1 "$E/bin/new-run" "$2" "$3" 3600 >/dev/null 2>&1; echo "$(date +%T) done $job"; done
