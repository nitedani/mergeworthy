#!/usr/bin/env bash
# night-run <task> <variant> [timeout]: one replay of <task> with prompts/<variant>.md as the built-in prompt and the
# local methodology, then its grader; appends "task variant run-dir score" to night.tsv.
set -uo pipefail
E="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"; T=$1; V=$2
export EVAL_PROMPT="$E/prompts/$V.md"; export LLM_PROFILE="$V"
R=$("$E/bin/new-run" "$T" local "${3:-3600}" | head -1)
g="$E/bin/grade-$T"; [ -x "$g" ] || g="$E/bin/grade-task"
"$g" "$R" >"$R/grade.txt" 2>&1
score=$(grep -m1 'hidden test:' "$R/grade.txt" | sed 's/.*hidden test: //')
echo -e "$T\t$V\t$(basename "$R")\t${score:-?}\t$(date +%H:%M)" | tee -a "$E/night.tsv"
