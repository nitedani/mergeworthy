#!/usr/bin/env python3
"""show-run <run dir> [--full]: the agent's actions from transcript.jsonl, one line each, plus the outcome."""
import json, sys, os
R = sys.argv[1]; full = '--full' in sys.argv
n = 0
for line in open(os.path.join(R, 'transcript.jsonl')):
    try: d = json.loads(line)
    except Exception: continue
    t = d.get('type')
    if t == 'assistant':
        for c in d['message'].get('content', []):
            if c.get('type') == 'tool_use':
                n += 1; i = c['input']
                s = i.get('command') or i.get('file_path') or i.get('pattern') or i.get('description') or json.dumps(i)
                print(f"{n:3} {c['name']:6} {str(s).replace(chr(10), ' ')[:None if full else 150]}")
            elif c.get('type') == 'text' and c['text'].strip():
                print(f"    say: {c['text'].strip().replace(chr(10), ' ')[:None if full else 200]}")
    elif t == 'result':
        print(f"\nRESULT ({d.get('subtype')}, {d.get('num_turns')} turns, {round(d.get('duration_ms', 0)/60000, 1)} min):\n{d.get('result', '')}")
