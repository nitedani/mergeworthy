#!/usr/bin/env python3
"""claude-usage [--json | --mode]: how much Claude subscription budget is left across your claude-swap accounts, and how hard to
lean on the local model to make it last.

Reads every claude-swap account's live usage (the numbers /usage shows): the active one with Claude Code's own login,
the others with their saved claude-swap logins. An inactive account's expired access token is refreshed the way Claude
Code does it (its OAuth client and token URL), under claude-swap's lock, and written back atomically to its saved login
(a backup of each saved login is kept in ~/local-llm/usage/backup/ before its first refresh). The active account's login
is never touched. Readings and burn-rate samples are kept in ~/local-llm/usage/.

Levels (weekly pool across all accounts, projected at the recent burn rate):
  green   the pool lasts past the next weekly reset with room to spare: delegate routine work only
  yellow  it would run out within 1.5x the time to that reset: also delegate drafts and first-pass checks
  red     it runs out before the next reset: the local model does the execution, Claude only decides and gates

--mode prints only the delegation level to use now (off | routine | execute), from ~/local-llm/delegation.conf: `mode`
normally, `escalate_to` while the pool, used `pace_margin` faster than the measured pace, would run out before the next weekly reset.
With `sticky`, an escalation holds until that reset. No rate measured yet means no escalation.
"""
import datetime as dt, json, os, sys, time, urllib.request

HOME = os.path.expanduser('~')
PROFILES = os.path.join(HOME, '.claude', 'profiles')
STORE = os.path.join(HOME, 'local-llm', 'usage')
LAST, SAMPLES = os.path.join(STORE, 'last.json'), os.path.join(STORE, 'samples.jsonl')
os.makedirs(STORE, exist_ok=True)

def ts(s):
    try: return dt.datetime.fromisoformat(str(s).replace('Z', '+00:00')).timestamp()
    except Exception: return None

TOKEN_URL, CLIENT_ID = 'https://platform.claude.com/v1/oauth/token', '9d1c250a-e61b-44d9-88ed-5944d1962f5e'  # Claude Code's
LOCK = os.path.join(PROFILES, '.lock')  # claude-swap's lock: one writer of saved logins at a time

class locked:
    def __enter__(self):
        import shutil
        start = time.time()
        while True:
            try:
                os.mkdir(LOCK); open(os.path.join(LOCK, 'pid'), 'w').write(str(os.getpid())); return self
            except FileExistsError:
                try:
                    pid = int(open(os.path.join(LOCK, 'pid')).read().strip() or 0)
                    if pid: os.kill(pid, 0)
                except ProcessLookupError:
                    shutil.rmtree(LOCK, ignore_errors=True); continue
                except Exception: pass
                if time.time() - start > 10: raise TimeoutError('claude-swap is busy')
                time.sleep(0.1)
    def __exit__(self, *a):
        import shutil; shutil.rmtree(LOCK, ignore_errors=True)

def write_private(path, data):
    tmp = path + f'.tmp{os.getpid()}'
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600); os.write(fd, data.encode()); os.close(fd)
    os.replace(tmp, path)

def saved_token(acct):
    """A valid access token for an inactive account, refreshing its saved login if it expired."""
    path = os.path.join(PROFILES, acct, 'credentials.json')
    if json.load(open(path))['claudeAiOauth'].get('expiresAt', 0) / 1000 > time.time() + 300:
        return json.load(open(path))['claudeAiOauth']['accessToken']
    with locked():
        ap = os.path.join(PROFILES, 'active')
        if os.path.exists(ap) and open(ap).read().strip() == acct:
            raise RuntimeError('became active')                       # its login is Claude Code's now: leave it alone
        full = json.load(open(path)); o = full['claudeAiOauth']        # re-read inside the lock
        if o.get('expiresAt', 0) / 1000 > time.time() + 300: return o['accessToken']
        bdir = os.path.join(STORE, 'backup'); os.makedirs(bdir, mode=0o700, exist_ok=True)
        bk = os.path.join(bdir, f'{acct}-credentials.json')
        if not os.path.exists(bk): write_private(bk, json.dumps(full))
        body = json.dumps({'grant_type': 'refresh_token', 'refresh_token': o['refreshToken'], 'client_id': CLIENT_ID}).encode()
        r = json.load(urllib.request.urlopen(urllib.request.Request(TOKEN_URL, data=body, method='POST',
                headers={'Content-Type': 'application/json', 'User-Agent': 'claude-usage'}), timeout=10))
        o['accessToken'] = r['access_token']
        if r.get('refresh_token'): o['refreshToken'] = r['refresh_token']
        if r.get('expires_in'): o['expiresAt'] = int((time.time() + int(r['expires_in'])) * 1000)
        write_private(path, json.dumps(full))
        return o['accessToken']

def read_usage(tok):
    req =urllib.request.Request('https://api.anthropic.com/api/oauth/usage', headers={
        'Authorization': 'Bearer ' + tok, 'anthropic-beta': 'oauth-2025-04-20', 'User-Agent': 'claude-usage'})
    d = json.load(urllib.request.urlopen(req, timeout=5))
    return {k: {'used': float(d[k].get('utilization') or 0), 'resets': ts(d[k].get('resets_at'))}
            for k in ('five_hour', 'seven_day') if isinstance(d.get(k), dict)}

now = time.time()
accounts = sorted(n for n in os.listdir(PROFILES) if os.path.isdir(os.path.join(PROFILES, n))) if os.path.isdir(PROFILES) else []
try: active = open(os.path.join(PROFILES, 'active')).read().strip()
except Exception: active = None
last = json.load(open(LAST)) if os.path.exists(LAST) else {}
errs = []
for acct in accounts:
    try:
        tok = (json.load(open(os.path.join(HOME, '.claude', '.credentials.json')))['claudeAiOauth']['accessToken']
               if acct == active else saved_token(acct))
        live = read_usage(tok)
        last[acct] = {**live, 'at': now}
        if acct == active:
            open(SAMPLES, 'a').write(json.dumps({'t': now, 'acct': acct, 'week': live['seven_day']['used']}) + '\n')
    except Exception as e:
        errs.append(f'{acct}: {type(e).__name__} {str(e)[:60]}')
json.dump(last, open(LAST, 'w'))
err = ('could not read ' + '; '.join(errs) + ' (using stored readings)') if errs else None

def current(acct, window):
    r = (last.get(acct) or {}).get(window)
    if not r: return None                       # never seen while active
    if r['resets'] and r['resets'] <= now: return 0.0   # its window reset since the reading
    return r['used']

# burn rate: the weekly window's average pace on the active account (used % / hours since the window started, the
# way claude.ai's usage page projects "you'll run out tonight"); a faster pace over the last 6 hours wins
rate = None
w = (last.get(active) or {}).get('seven_day') if active else None
if w and w.get('resets'):
    elapsed_h = (now - (w['resets'] - 7 * 24 * 3600)) / 3600
    if elapsed_h >= 1: rate = w['used'] / elapsed_h
if os.path.exists(SAMPLES):
    pts = [json.loads(l) for l in open(SAMPLES) if l.strip()]
    pts = [p for p in pts if p['acct'] == active and now - p['t'] <= 6 * 3600]
    if len(pts) >= 2 and pts[-1]['t'] - pts[0]['t'] >= 1800 and pts[-1]['week'] >= pts[0]['week']:  # 30 min of samples
        rate_recent_own = (pts[-1]['week'] - pts[0]['week']) / ((pts[-1]['t'] - pts[0]['t']) / 3600)
        rate = max(rate or 0, rate_recent_own)   # escalating: the faster of the two
try: rate_recent_own
except NameError: rate_recent_own = None       # de-escalating: the last 6 hours' pace, so slowing down counts

known = {a: current(a, 'seven_day') for a in accounts}

# Plans differ (Max 20x, Max 5x, Pro, Team): weight each account's % by its plan's weekly size, relative to Max 20x,
# so the pool and the burn rate are in "% of a Max 20x week". Sizes from Anthropic's plan pages, Pro = 1; override
# per tier in delegation.conf as `weight.<rateLimitTier> = <number>`.
WEIGHTS = {'max_20x': 20, 'max_5x': 5, 'pro': 1, 'raven': 1.25}   # raven = Team seat (standard assumed)
conf_w = {}
try:
    for line in open(os.path.join(HOME, 'local-llm', 'delegation.conf')):
        k, _, v = line.split('#')[0].partition('=')
        if k.strip().startswith('weight.') and v.strip(): conf_w[k.strip()[7:]] = float(v)
except FileNotFoundError: pass
def tier(acct):
    p = os.path.join(HOME, '.claude', '.credentials.json') if acct == active else os.path.join(PROFILES, acct, 'credentials.json')
    try: return json.load(open(p))['claudeAiOauth'].get('rateLimitTier') or '?'
    except Exception: return '?'
def weight(acct):
    t = tier(acct)
    if t in conf_w: return conf_w[t] / 20
    return next((w for key, w in WEIGHTS.items() if key in t), 1) / 20
wt = {a: weight(a) for a in accounts}
pool_left = sum((100 - v) * wt[a] for a, v in known.items() if v is not None)
unknown = [a for a, v in known.items() if v is None]
resets = [last[a]['seven_day']['resets'] for a in accounts if a in last and last[a].get('seven_day', {}).get('resets', 0) and last[a]['seven_day']['resets'] > now]
next_reset_h = (min(resets) - now) / 3600 if resets else None
five = current(active, 'five_hour') if active else None

own = ''
hours_left = None
rate_own = rate                                   # % of the active account's own week per hour
if rate is not None and active: rate = rate * wt[active]   # → % of a Max 20x week per hour, like the pool
if active and rate_own and w and known.get(active) is not None:
    h = (100 - known[active]) / rate_own; reset_h = (w['resets'] - now) / 3600
    own = (f'; {active} alone runs out in ~{h:.0f} h at {rate_own:.1f}%/h, ' +
           ('before' if h < reset_h else 'after') + f' its reset in {reset_h:.0f} h')
if unknown:
    level, why = 'unknown', f'no reading yet for {", ".join(unknown)} (each is read the first time it is the active account){own}'
elif rate is None or rate <= 0 or next_reset_h is None:
    level, why = 'green', 'no burn rate measured yet' if rate is None else 'not spending'
    # without a rate, judge by what's left: under 15% of one account's week across the pool is already tight
    if pool_left < 15: level, why = 'red', f'only {pool_left:.0f}% of a week left across known accounts'
else:
    # hours left = each account's remaining % at its own pace (measured while it was active), summed; an account
    # never seen active falls back to the active account's pace converted by plan size
    allpts = [json.loads(l) for l in open(SAMPLES) if l.strip()] if os.path.exists(SAMPLES) else []
    def own_pace(acct, active_pace):
        p = [x for x in allpts if x['acct'] == acct]
        if len(p) >= 2 and p[-1]['t'] - p[0]['t'] >= 1800 and p[-1]['week'] > p[0]['week']:
            return (p[-1]['week'] - p[0]['week']) / ((p[-1]['t'] - p[0]['t']) / 3600)
        return active_pace * wt[active] / wt[acct] if active_pace else None
    def hours_at(active_pace):
        paces = {a: (active_pace if a == active else own_pace(a, active_pace))
                 for a in accounts if known[a] is not None and known[a] < 100}
        return sum((100 - known[a]) / p for a, p in paces.items() if p) if paces else 0
    hours_left = hours_at(rate_own)
    hours_left_recent = hours_at(rate_recent_own) if rate_recent_own else None
    level = 'red' if hours_left < next_reset_h else 'yellow' if hours_left < 1.5 * next_reset_h else 'green'
    why = (f'the pool left is {pool_left:.0f}% of a Max 20x week; at {rate:.1f}%/h it lasts {hours_left:.0f} h; '
           f'next weekly reset in {next_reset_h:.0f} h')
if five is not None and five >= 80 and level == 'green': level, why = 'yellow', f'5-hour window at {five:.0f}%'

advice = {'unknown': 'no prediction yet: use the configured mode', 'green': 'delegate routine work (gates, fact mining, mechanical edits) to the local model',
          'yellow': 'also delegate first drafts and first-pass fact checks to the local model; Claude verifies; fewer cloud subagents',
          'red': 'the local model does the execution; Claude only decides, reviews what gates a post, and posts'}[level]
res = {'level': level, 'why': why, 'advice': advice, 'active': active, 'five_hour': five,
       'weekly': {a: known[a] for a in accounts}, 'unknown_accounts': unknown, 'rate_pct_per_h': rate, 'note': err}
if '--mode' in sys.argv:
    conf = {'mode': 'routine', 'escalate_to': 'execute', 'pace_margin': '20%', 'deescalate_margin': '50%', 'deescalate_after': '2'}
    try:
        for line in open(os.path.join(HOME, 'local-llm', 'delegation.conf')):
            k, _, v = line.split('#')[0].partition('=')
            if v.strip(): conf[k.strip()] = v.strip()
    except FileNotFoundError: pass
    state_p = os.path.join(STORE, 'escalation.json')
    state = json.load(open(state_p)) if os.path.exists(state_p) else {}
    # escalate only on complete data: every account read at least once, and a measured burn rate
    margin = 1 + float(conf['pace_margin'].rstrip('%')) / 100      # assume using it this much faster than measured
    pressed = bool(not unknown and hours_left is not None and next_reset_h is not None and hours_left / margin < next_reset_h)
    # Hysteresis: once escalated, de-escalate only when the forecast at the recent (last 6 h) pace clears the next reset
    # by deescalate_margin and has stayed clear for deescalate_after hours; a weekly reset ends it too.
    if pressed:
        state = {'since': state.get('since', now), 'until': min(resets) if resets else now + 86400}
    elif state:
        clear_need = 1 + float(conf['deescalate_margin'].rstrip('%')) / 100
        h_recent = hours_left_recent if hours_left_recent is not None else hours_left
        clear = h_recent is not None and next_reset_h is not None and h_recent >= next_reset_h * clear_need
        state['clear_since'] = (state.get('clear_since') or now) if clear else None
        if state.get('until', 0) <= now or (clear and now - state['clear_since'] >= float(conf['deescalate_after']) * 3600):
            state = {}
    if state: json.dump(state, open(state_p, 'w'))
    elif os.path.exists(state_p): os.remove(state_p)
    print(conf['escalate_to'] if state else conf['mode'])
    sys.exit(0)
if '--json' in sys.argv: print(json.dumps(res)); sys.exit(0)
print(f"{'NO PREDICTION' if level == 'unknown' else level.upper()}: {why}")
print(f"  weekly used: " + ', '.join(f"{a} {'?' if v is None else f'{v:.0f}%'} of {wt[a] * 20:g}x" for a, v in known.items()) +
      (f"; 5-hour ({active}): {five:.0f}%" if five is not None else ''))
if unknown: print(f"  not yet seen while active: {', '.join(unknown)} (counted as unknown, not free)")
print(f"  → {advice}")
if err: print(f"  note: {err}")
