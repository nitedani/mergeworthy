#!/usr/bin/env bash
# Claude Code on the local model. Affects only the session it starts: your accounts, claude-swap and
# every other `claude` session are untouched. Starts the local server if it isn't running, and stops it when the last
# claude-local session exits, or within 30 s if the wrapper is killed (serve.sh reap); idle sessions unload the model.
# Arguments are passed to claude (e.g. `claude-local -c` to continue the last local session).
set -euo pipefail
DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
source "$DIR/profile.sh"
# Commands that don't talk to the model (version checks by t3 and other tools, help, auth, doctor, mcp…) skip the
# server: starting it would make them slow (a cold model load) and stopping it on exit would kill it for everyone.
NO_MODEL=""
case "${1:-}" in
  -v|-V|--version|-h|--help|auth|doctor|update|install|config|mcp|plugin|plugins|setup-token|migrate-installer) NO_MODEL=1 ;;
esac
[ -n "$NO_MODEL" ] || "$DIR/serve.sh" start >&2

# Own config folder: Claude Code runs /background sessions in a shared host process started by whichever `claude` came
# first, and that host doesn't pass on ANTHROPIC_BASE_URL, so a local session sent there asked Anthropic for the local model
# (404). A separate folder gets a separate host, started from here with the variables below. Your settings, hooks,
# skills and plugins are linked in, your CLAUDE.md is copied with claude-local-overrides.md added; history stays separate.
CFG="$DIR/claude-config"
mkdir -p "$CFG"
for f in settings.json skills plugins; do
  [ -e "$HOME/.claude/$f" ] && [ ! -e "$CFG/$f" ] && ln -s "$HOME/.claude/$f" "$CFG/$f"
done
# Your CLAUDE.md plus the local-model environment notes (no usage limits, one model, one GPU), rebuilt every start.
# Methodology: rebuilt from your methodology's text on every start, word for word, minus the scripts' source code
# that its build.sh appends (build-local-methodology.sh); ~30% fewer words, never stale.
FULL="$(grep -o '/[^` ]*methodology[^` ]*\.md' "$HOME/.claude/CLAUDE.md" | head -1)"
METH="$FULL"
if [ -n "$FULL" ] && "$DIR/build-local-methodology.sh" "$FULL" "$CFG/methodology-local.md" 2>/dev/null; then
  METH="$CFG/methodology-local.md"
fi
rm -f "$CFG/CLAUDE.md"
{ sed "s#${FULL:-/nonexistent}#$METH#g" "$HOME/.claude/CLAUDE.md"; cat "$DIR/claude-local-overrides.md"; echo; cat "$DIR/claude-local-prompt.md"; } >"$CFG/CLAUDE.md" 2>/dev/null || true
# Copy what lives in ~/.claude.json: theme and first-run state, MCP servers, folders you trusted.
python3 - "$HOME/.claude.json" "$CFG/.claude.json" <<'EOF'
import json, os, sys
src = json.load(open(sys.argv[1]))
dst = json.load(open(sys.argv[2])) if os.path.exists(sys.argv[2]) else {}
for k in ('theme', 'hasCompletedOnboarding', 'lastOnboardingVersion', 'lastReleaseNotesSeen', 'mcpServers'):
    if k in src: dst[k] = src[k]
# WebSearch runs on Anthropic's servers; the local model gets web_search from web-search-mcp instead
dst.setdefault('mcpServers', {})['web-search'] = {'type': 'stdio', 'command': os.path.normpath(os.path.join(os.path.dirname(sys.argv[2]), '..', 'web-search-mcp'))}
for path, p in src.get('projects', {}).items():
    if p.get('hasTrustDialogAccepted'): dst.setdefault('projects', {}).setdefault(path, {})['hasTrustDialogAccepted'] = True
tmp = sys.argv[2] + '.tmp'; json.dump(dst, open(tmp, 'w'), indent=2); os.replace(tmp, sys.argv[2])
EOF
export CLAUDE_CONFIG_DIR="$CFG"

export ANTHROPIC_BASE_URL="http://127.0.0.1:${LLM_PORT:-8080}"
export ANTHROPIC_AUTH_TOKEN="$(cat "$DIR/.api-key")"  # also keeps your Claude login from being sent to the local server
unset ANTHROPIC_API_KEY
for v in ANTHROPIC_MODEL ANTHROPIC_DEFAULT_OPUS_MODEL ANTHROPIC_DEFAULT_SONNET_MODEL ANTHROPIC_DEFAULT_HAIKU_MODEL CLAUDE_CODE_SUBAGENT_MODEL; do
  export "$v"=local
done
# Claude Code compacts at LLM_COMPACT (3/4 of the server's window, profile.sh), because the compaction request
# itself — conversation + summarizer prompt + summary — must fit in the window; at the window's edge it overflows
# and the session dies. (Claude Code assumes 200K for a model it doesn't know and would compact too late.)
export CLAUDE_CODE_MAX_CONTEXT_TOKENS="$LLM_CTX" CLAUDE_CODE_AUTO_COMPACT_WINDOW="$LLM_COMPACT"
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
[ -n "$NO_MODEL" ] && exec claude "$@"
SESSIONS="$DIR/.sessions"; mkdir -p "$SESSIONS"; touch "$SESSIONS/$$"
# Built-in prompt: steps against the mistakes this model made in tested work (claude-local-prompt.md)
# setpriv --pdeathsig: Claude stops when this wrapper is stopped (t3's stop button ends the wrapper, not its child)
# Fast path when the wrapper ends normally or is hung up; serve.sh's reaper covers a killed wrapper (t3's stop button)
cleanup() {
rm -f "$SESSIONS/$$"
"$DIR/serve.sh" in-use || "$DIR/serve.sh" stop >/dev/null
}
trap 'trap - EXIT; cleanup; exit $code' EXIT HUP TERM INT
code=0; setpriv --pdeathsig TERM claude --allowedTools mcp__web-search__web_search --append-system-prompt "$(cat "$DIR/claude-local-prompt.md")" "$@" || code=$?
