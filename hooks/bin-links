#!/bin/bash
# bin-links [<version folder>]: puts every tool in that version's bin/ (default: this one's) on PATH through the stable path (~/.local/bin/<tool> ->
# ~/.mergeworthy/current/bin/<tool>), so a tool added in an update is usable without a manual link; a name ~/.local/bin already
# holds stays. Run by session-start, npx mergeworthy and Antigravity's SessionStart (hooks/agy.py).
# Exits 1 when a link it makes fails, after trying every other one.
mkdir -p ~/.local/bin || exit 1
rc=0
for t in "${1:-$(dirname "$(readlink -f "$0")")/..}"/bin/*; do n=$(basename "$t"); [ -e ~/.local/bin/"$n" ] || [ -L ~/.local/bin/"$n" ] || ln -s ~/.mergeworthy/current/bin/"$n" ~/.local/bin/"$n" || rc=1; done
exit $rc
