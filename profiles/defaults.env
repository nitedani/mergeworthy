# Every setting with its default; the comment lists its values. build.sh sources this file, then each named profile in order.
target=local                     # local | ci
ownership=external               # external | team | own
tests=remove-before-merge        # remove-before-merge | keep
merge=on-request-squash          # on-request-squash | reviewer
pr_open=ready                    # ready | draft
review_trace=comment             # hidden | comment; user decision 2026-10-04: ratings go in a PR comment, in the timeline
badge=on                         # on | off | auto
post_lang=en                     # en | thread
reviewer=codex-then-claude       # codex-then-claude | claude
watcher=on                       # on | off
commit_identity=noreply          # noreply | git-config
local_model=on                   # on | off
session_model=claude             # claude | local
