#!/bin/bash
# gate-pass <draft.md> <review-output-file> [--ledger <path>] [post-lint flags]: records that <draft.md> passed the posting gate.
# Requires post-lint to pass, a current thread-context.md next to a reply/inline/proposal draft, and the review's final message to be exactly CLEAN (the reviewer writes only its verdict to that file), or `--ledger <path>` (default: <name>.ledger.md beside the draft) closing its loop (hooks/ledger.py).
# Writes <draft.md>.gate with the draft's sha256; the posting hook checks it, so any later edit needs a new review.
# A status post (post-lint --kind status, post step 3) has no review: its review output is `none`, and it needs its PROMISED line.
set -e
d="$1"; r="$2"
[ -f "$d" ] && { [ -f "$r" ] || [ "$r" = none ]; } || { echo "usage: gate-pass <draft.md> <review-output>|none [--ledger <path>] [post-lint flags]"; exit 2; }
# the flags given here, else those the draft last passed post-lint with (<draft>.lint), else a reply's
shift 2; flags=(); ledger=; while [ $# -gt 0 ]; do if [ "$1" = --ledger ]; then ledger=${2:?--ledger <path>}; shift 2; else flags+=("$1"); shift; fi; done; [ ${#flags[@]} -gt 0 ] || { [ -f "$d.lint" ] && read -ra flags < "$d.lint"; } || true
"$(dirname "$(readlink -f "$0")")/post-lint" "$d" "${flags[@]}" || { echo "post-lint failed"; exit 1; }
kind=reply; for i in "${!flags[@]}"; do [ "${flags[$i]}" = --kind ] && kind="${flags[$((i+1))]}"; done
[ "$r" != none ] || [ "$kind" = status ] || { echo "only a status post (post-lint --kind status) skips the review: run it (post step 3)"; exit 1; }
# a reply, inline comment or proposal is drafted from the whole thread: thread-context.md (post step 1) next to the draft, newer than the comment it answers
case "$kind" in reply|comment|inline|proposal|status)
  parent="${d%.md}.parent.md"; [ -f "$parent" ] || parent=""
  "$(dirname "$(readlink -f "$0")")/thread-context" --verify "$(dirname "$(readlink -f "$d")")/thread-context.md" ${parent:+--parent "$parent"} || exit 1;;
esac
# the review lets this text be posted (review_launch.answers, which pre-agent-dedupe asks too): a draft edited since its launch, such as
# a trim to the length ceiling, is reviewed again; the footer appended below is no edit
why=$(python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); import review_launch
why = review_launch.answers(None if sys.argv[2] == "none" else sys.argv[2], sys.argv[3], sys.argv[4] or None); print(why); sys.exit(1 if why else 0)' \
  "$(dirname "$(readlink -f "$0")")/../hooks" "$r" "$d" "$ledger") || { echo "$why"; exit 1; }
# a posted promise is a task opened (mergeworthy:post step 4): it needs a PROMISED line naming this draft in proposals-open.md
own=$(python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); import post_words; sys.stdout.write(post_words.uncoded(open(sys.argv[2]).read()))' "$(dirname "$(readlink -f "$0")")/../hooks" "$d" |
  sed -E 's/"[^"]*"//g; s/“[^”]*”//g; s/`[^`]*`//g; /^>/d')  # quoted text and code blocks are someone else's words or a tool's output, not a promise
if [ "$kind" = status ] || { printf '%s\n' "$own" | grep -qiE "\b(I'll|I will)\b|follow-up PR|subsequent PR|separate PR" && ! printf '%s\n' "$own" | grep -qiE "\b(and|then) I'll (squash-)?merge"; }; then
  # the list lives in the session's watch dir (github-threads), or beside a drafts folder kept in it
  po="$(dirname "$(readlink -f "$d")")/../proposals-open.md"
  while read -r w; do [ -n "${CLAUDE_CODE_SESSION_ID:-}" ] && [ "$(cat "$w/session" 2>/dev/null)" = "$CLAUDE_CODE_SESSION_ID" ] && po="$w/proposals-open.md"; done < <(cat ~/.claude/gh-watch-dirs.txt 2>/dev/null)
  grep -q "^PROMISED .*$(basename "$d")" "$po" "$(dirname "$(readlink -f "$d")")/../proposals-open.md" 2>/dev/null || { echo "the draft promises work: add 'PROMISED <thread>: <what> ($(basename "$d"))' to $po first, or do it now and write 'Done in <link>'"; exit 1; }
fi
# A maintainer who asked to see how this methodology changes (~/.mergeworthy/harness-shown/<owner>, the last mergeworthy
# commit shown there) gets one line linking every commit since: added here, after the review, so the reviewer never sees it
repo=""; for i in "${!flags[@]}"; do [ "${flags[$i]}" = --repo ] && repo="${flags[$((i+1))]}"; done
hs="${MERGEWORTHY_HOME:-$HOME/.mergeworthy}/harness-shown/${repo%%/*}"
installed=$(git -C "${MERGEWORTHY_SRC:-$HOME/.claude/plugins/marketplaces/mergeworthy}" rev-parse --short=7 HEAD 2>/dev/null || true)
shown=$(cat "$hs" 2>/dev/null | head -c 40 | tr -d '[:space:]' || true)
case "$kind" in reply|comment|proposal)
  # once per draft: a second gate-pass on the same draft (after a re-review) keeps the line it already has
  if [ -n "$repo" ] && [ -f "$hs" ] && [ -n "$installed" ] && [ "$shown" != "$installed" ] && ! grep -q '^Harness changes since my last note: ' "$d"; then
    printf '\nHarness changes since my last note: <https://github.com/nitedani/mergeworthy/compare/%s...%s>\n' "$shown" "$installed" >> "$d"
  fi;;
esac
sha256sum "$d" | cut -d' ' -f1 > "$d.gate"
# the draft was written from the thread's record, and the reviewer had the same file;
# its hash goes into the gate record, so the posting hook can tell it from one made after the review
tcf="$(dirname "$(readlink -f "$d")")/thread-context.md"
[ -f "$tcf" ] && echo "tc $(sha256sum "$tcf" | cut -d' ' -f1)" >> "$d.gate"
echo "gate passed: $d"
# the draft now links every mergeworthy commit up to the installed one: record it as shown
case "$kind" in reply|comment|proposal) [ -n "$repo" ] && [ -f "$hs" ] && [ -n "$installed" ] && echo "$installed" > "$hs";; esac
# Register the post, so the watcher can tell the agent's posts from the user's when both use one account
REG="${GATED_POSTS:-$HOME/.claude/gated-posts.txt}"
python3 -c 'import hashlib,sys; print(hashlib.sha256(open(sys.argv[1]).read().replace("\r\n","\n").strip().encode()).hexdigest())' "$d" >> "$REG"
