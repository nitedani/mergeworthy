#!/usr/bin/env node
import { realCtx } from '../lib/ctx.mjs'
import { diffLintCommand, locCommand } from '../lib/diff.mjs'
import { followupsCommand } from '../lib/followups.mjs'
import { lintCommand } from '../lib/lint.mjs'
import { loadCommand } from '../lib/load.mjs'
import { netnsCommand } from '../lib/netns.mjs'
import { postCommand, verdictCommand } from '../lib/post.mjs'
import { stepCommand, stepsCommand } from '../lib/steps.mjs'
import { threadCommand } from '../lib/thread.mjs'
import { watchCommand } from '../lib/watch.mjs'

const COMMANDS = {
  thread: { run: threadCommand, usage: 'mw thread <url|owner/repo#number>', summary: 'The whole thread as markdown: body, comments, reviews, inline comments and cross-references, with permalinks.' },
  lint: { run: lintCommand, usage: 'mw lint <draft> [--repo owner/repo] [--kind reply|design|pr|issue|umbrella]', summary: 'Checks a draft before posting; exits 1 on any error.' },
  verdict: { run: verdictCommand, usage: 'mw verdict <draft> CLEAN|CHANGES --by <who>', summary: "Run by the reviewer: records the verdict with the draft's sha256 in <draft>.verdict.json." },
  post: { run: postCommand, usage: 'mw post [--I_UNDERSTAND_IMPLICATIONS_AND_BYPASS_GATE <reason>] [--kind <kind>] <draft> -- gh <args...>', summary: 'Lints the draft, checks its CLEAN verdict and the thread, then runs the gh command that posts it.' },
  watch: { run: watchCommand, usage: 'mw watch <url...> [--commands --workspace <name>] [--interval 60] [--max 110m] [--once]', summary: 'One GraphQL request per poll; exits on the first batch of events and prints the re-arm command.' },
  step: { run: stepCommand, usage: 'mw step <gates|verify|quality|review> <evidence path> [--pr <url>]', summary: "Records a converge step on the checkout's head and its own diff; --pr labels it." },
  steps: { run: stepsCommand, usage: 'mw steps [--pr <url>]', summary: 'Lists each required step: done on this head, on an older head, or missing.' },
  'diff-lint': { run: diffLintCommand, usage: 'mw diff-lint [base]', summary: 'Warns on added multi-line or history comments and on timed waits added in tests.' },
  loc: { run: locCommand, usage: 'mw loc [base] [--map <file>]', summary: 'Lines changed per feature (map lines: <glob> = <feature>), with tests and docs apart.' },
  followups: { run: followupsCommand, usage: 'mw followups <owner/repo> [--days 14]', summary: 'Commits others made to the files of your PRs merged in that window.' },
  netns: { run: netnsCommand, usage: 'mw netns [--publish <port>[,...]] -- <command...>', summary: 'Runs the command in a private network namespace with its own ports and internet through slirp4netns; --publish prints a 127.0.0.1 URL for each port inside.' },
  load: { run: loadCommand, usage: 'mw load', summary: 'Free memory, load average, cores, and the claude, codex and chrome processes with their memory.' },
}

const [name, ...args] = process.argv.slice(2)
const ownArgs = args.includes('--') ? args.slice(0, args.indexOf('--')) : args
if (!COMMANDS[name]) {
  console.log(['usage: mw <command> [args]', '', ...Object.values(COMMANDS).map(({ usage, summary }) => `  ${usage}\n      ${summary}`)].join('\n'))
  process.exit(name === undefined || name === 'help' || name === '--help' ? 0 : 2)
}
const { run, usage, summary } = COMMANDS[name]
if (ownArgs.includes('--help')) {
  console.log(`usage: ${usage}\n\n${summary}`)
  process.exit(0)
}
try {
  const code = await run(args, realCtx())
  if (code === 2) console.error(`usage: ${usage}`)
  process.exit(code)
} catch (error) {
  console.error(`mw ${name}: ${error.message}`)
  process.exit(1)
}
