#!/usr/bin/env python3
"""Select explicit T3 delegate_task targets from its current provider catalog."""

import argparse
import json
import math
from pathlib import Path
import re
import subprocess
import sys


PROVIDERS = {
    'claudeAgent': 'claude',
    'codex': 'codex',
    'antigravity': 'antigravity',
}
ORDER = {
    'implementation': ('claude', 'antigravity', 'codex'),
    'review': ('codex', 'antigravity', 'claude'),
    'design': ('claude', 'codex', 'antigravity'),
    'research': ('claude', 'codex', 'antigravity'),
    'test': ('claude', 'codex', 'antigravity'),
    'judge': ('claude', 'codex', 'antigravity'),
}
EFFORT = {
    'implementation': 'high',
    'review': 'high',
    'design': 'high',
    'research': 'medium',
    'test': 'high',
    'judge': 'high',
}


def read_capacity():
    try:
        result = subprocess.run(['claude-swap', 'agent-capacity'], capture_output=True, text=True, timeout=8, check=True)
        value = json.loads(result.stdout)
        return value if isinstance(value, dict) else {}
    except (OSError, ValueError, subprocess.SubprocessError):
        return {}


def model_rank(family, role, name):
    if family == 'claude':
        classes = {
            'judge': ('fable', 'opus'),
            'test': ('haiku', 'opus'),
        }.get(role, ('opus',))
        for rank, model_class in enumerate(classes):
            match = re.fullmatch(rf'claude-{model_class}-(\d+)[.-](\d+)(?:-\d{{8}})?', name)
            if match:
                return rank, -int(match[1]), -int(match[2]), name
    elif family == 'codex':
        match = re.fullmatch(r'gpt-(\d+)\.(\d+)-sol', name)
        if match:
            return 0, -int(match[1]), -int(match[2]), name
    elif name in ('gemini-4-neon', 'gemini-4-neon-medium'):
        return 0, 0, 0, name
    return None


def eligible(catalog, role, authors, required_effort=None):
    """One advertised model per provider family, preferring the inherited or Mergeworthy instance."""
    candidates = {}
    inherited = catalog.get('inheritedProviderInstanceId')
    for provider in catalog.get('providers', []):
        kind = provider.get('driverKind')
        instance = provider.get('providerInstanceId')
        if kind not in PROVIDERS or not instance or not provider.get('canRunChildTask'):
            continue
        if instance != inherited and not provider.get('canRunCrossProviderChildTask'):
            continue
        family = PROVIDERS[kind]
        if family in authors:
            continue
        for model in provider.get('models', []):
            name = model.get('id', '')
            model_preference = model_rank(family, role, name)
            if model_preference is None:
                continue
            options = model.get('options') or []
            effort = required_effort or EFFORT[role]
            selection = {option['id']: effort for option in options
                         if option.get('id') in ('effort', 'reasoningEffort', 'reasoning_effort')
                         and effort in option.get('values', [])}
            if required_effort and not selection:
                continue
            rank = ('mergeworthy' not in instance.lower(), instance != inherited, model_preference, instance)
            target = {'driverKind': kind, 'providerInstanceId': instance, 'model': name}
            if selection:
                target['options'] = selection
            if family not in candidates or rank < candidates[family][0]:
                candidates[family] = (rank, target)
    return {family: target for family, (_, target) in candidates.items()}


def choose(catalog, usage, role, authors, count, previous, effort=None, excluded=()):
    available = eligible(catalog, role, authors, effort)
    order = [family for family in ORDER[role] if family in available and family not in excluded
             and (usage.get(family) or {}).get('blocked') is not True]
    if role == 'judge':
        order = [family for family in order if family == 'claude']
    prior = [family for target in previous for family in order if target == available[family]]
    pace = {family: (usage.get(family) or {}).get('pace') for family in order}
    for family, value in pace.items():
        if type(value) not in (int, float) or not math.isfinite(value):
            pace[family] = None

    if count == 1 and order:
        preferred = prior[0] if prior else order[0]
        # A healthy existing assignment survives quota noise. Move work when the current provider is materially
        # ahead of its consumption budget and another provider has more capacity left relative to its reset.
        if not (role == 'review' and prior) and pace[preferred] is not None and pace[preferred] <= -10:
            room = [p for p in order if pace[p] is not None and pace[p] >= pace[preferred] + 10]
            if room:
                preferred = max(room, key=pace.get)
        order = [preferred]
    else:
        order = list(dict.fromkeys([*prior, *order]))

    return {'targets': [available[family] for family in order[:count]], 'requested': count}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('role', choices=ORDER)
    parser.add_argument('catalog', type=Path, help='Structured orchestrator_capabilities result')
    parser.add_argument('--author', action='append', default=[], choices=PROVIDERS.values())
    parser.add_argument('--exclude', action='append', default=[], choices=PROVIDERS.values())
    parser.add_argument('--effort', help='Required effort, such as a project override')
    parser.add_argument('--count', type=int, choices=(1, 2, 3), default=1)
    parser.add_argument('--previous', type=Path, help='A prior agent-targets result for the same review loop or panel')
    args = parser.parse_args()
    if args.role == 'review' and not args.author:
        parser.error('reviews require the company that wrote the artifact')
    catalog = json.loads(args.catalog.read_text())
    previous = json.loads(args.previous.read_text())['targets'] if args.previous else []
    selection = choose(catalog, read_capacity(), args.role, args.author, args.count, previous, args.effort, args.exclude)
    print(json.dumps(selection))
    return 0 if len(selection['targets']) == args.count else 1


if __name__ == '__main__':
    sys.exit(main())
