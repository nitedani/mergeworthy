#!/usr/bin/env bash
# pr-steps <step> <output-file>: records that a converge step ran on the current HEAD, after checking its output proves it.
# verify, reverify, small, shape and fresh take `--ledger <path>` for a round 2 whose verdict isn't clean: the loop's ledger closes it (hooks/ledger.py), a finding on a post's draft by its gate-pass record.
# Steps, in pipeline order (mergeworthy:converge): verify (Loop A), shape (Loop B: the review and the shape pass),
# reverify (Loop A after Loop B's commits), fresh (the fresh reader), gates (every gate's exit code on the final head).
# The posting hook blocks `gh pr create` (unless --draft), `gh pr ready` and pushes to a ready PR until HEAD has all five.
# quick: the quick gates' exit codes on a head (code §Gates), which a push to a PR or another owner's repo, and `gh pr create`, need on the pushed head.
# layout: a layout check's lines (evidence step 4), each screenshot OK or its defect with the place it comes from, outside the functions the branch changes.
# finality: the finality pass's pinnacle and plan (finality step 3), which a code file's change past the drift limit on the branch needs on the head
# (pre-bash-guard; hooks/records.py LIMIT). A review (verify, shape, reverify, fresh, small) or a finality is also a note of its kind on the head under
# the drift ref (records.py DRIFT_REF, NOTE_KIND), a finality's with a line 'plan <its numbered steps>', written before the record, which git
# carries through an amend or a rebase (hooks/drift.py).
# union <log> | --conflict <sha>: two ready PRs of ours sharing a file, checked together (merging step 2): in a checkout of their merge, the log's
# first line 'Union: <owner/repo>#<A>@<sha> + #<B>@<sha> on <base>@<sha>' and its quick gates; or, in one PR's checkout, its textual conflict with the other's head.
set -euo pipefail
# The first sentence of each code/SKILL.md section a checker's brief names: its file copies them under '## Standards read', proof it read them
standards() { python3 - "$(dirname "$(realpath "$0")")/../skills/code/SKILL.md" <<'EOF'
import re, sys
s = open(sys.argv[1]).read()
for name in ('Phantom gate', 'Docs are a claim', 'No regressions'):
    body = re.search(r'^### ' + re.escape(name) + r'\n+(.+)', s, re.M).group(1)
    print(re.match(r'.+?[.:](?=\s|$)', body).group(0))
EOF
}
[ "${1:-}" = standards ] && { standards; exit 0; }
read_standards() {
  sec=$(awk '/^## Standards read/{f=1;next} /^## /{f=0} f' "$out" | tr -s ' \n' '  ')
  miss=$(standards | while IFS= read -r l; do case "$sec" in *"$l"*) ;; *) printf '%s\n' "$l" ;; esac; done)
  [ -z "$miss" ] || { printf '%s\n' "$out has no '## Standards read' copying the first sentence of each code/SKILL.md section its brief names (read them before checking; the brief of this step: mergeworthy delegate/verifier.md, shape.md or fresh-reader.md). Missing:" "$miss" >&2; exit 1; }
}
step=${1:?usage: pr-steps <preflight|approach|small|quick|layout|verify|shape|reverify|fresh|gates|finality|union> <output-file> [--ledger <path>]}; out=${2:?output file}
ledger=; [ "${3:-}" != --ledger ] || ledger=${4:?--ledger <path>}
ledger_ok() { [ -n "$ledger" ] && python3 "$(dirname "$(realpath "$0")")/../hooks/ledger.py" "$ledger"; }
case "$step" in preflight|approach|small|quick|layout|verify|shape|loopb|refactor|reverify|fresh|gates|finality|union) ;; review) step=fresh ;;
  *) echo "step must be preflight, approach, small, quick, layout, verify, shape, reverify, fresh, gates, finality or union" >&2; exit 1;; esac
# preflight and approach: one record per repo and branch, the path the hooks read (hooks/records.py branch_record)
mkdir -p ~/.claude/pr-steps
approach=$(python3 "$(dirname "$(realpath "$0")")/../hooks/records.py" approach)
# A branch whose latest approach record has no `contract: 2` field was started by a session on v1's skills (before the shape
# pass and the maintainer's fresh read): it finishes under that contract (loopb and refactor, a fresh report without a Maintainer line).
old_pipeline() { [ -s "$approach" ] && ! tail -n1 "$approach" | grep -q ' contract: 2$'; }
case "$step" in loopb|refactor) old_pipeline || { echo "pr-steps shape replaces loopb and refactor: record Loop B's shape report (mergeworthy:converge step 2). Only a branch whose approach a session on v1's skills recorded (no contract: 2) still records them." >&2; exit 1; };; esac
# pr-steps preflight <app URL> [Chrome flags] | <PNG the session's browser MCP took just now> | 'none, because <why>':
# before any code, the app runs and browser control loads it (pull-request, Check you can finish before you start)
if [ "$step" = preflight ]; then
  shift; preflight=$(python3 "$(dirname "$(realpath "$0")")/../hooks/records.py" preflight); proof=$preflight.png
  case "$out" in
    "none, because "?*) proof=$out ;;
    http://*|https://*)
      shift; chrome=${CHROME:-$(command -v google-chrome chromium chromium-browser | head -n1 || true)}
      [ -n "$chrome" ] || { echo "no Chrome on PATH: screenshot the app with the session's browser MCP, then pr-steps preflight <that PNG>" >&2; exit 1; }
      profile=$(mktemp -d); trap 'rm -rf "$profile"' EXIT
      unset PULSE_SERVER  # WSLg hands its audio server to Chrome: the page would play on the user's speakers
      flags=(--headless=new --mute-audio --user-data-dir="$profile" --ignore-certificate-errors --window-size=1440,900 --virtual-time-budget=15000 "$@")
      timeout 120 "$chrome" "${flags[@]}" --dump-dom "$out" 2>/dev/null | python3 -c 'import re, sys; d = sys.stdin.read()
sys.exit("main-frame-error" in d or not re.sub(r"<[^>]*>|\s", "", re.sub(r"(?is)<(script|style)\b.*?</\1>", "", d)))' ||
        { echo "$out showed Chrome's error page or a blank page: start the app (and pass the Chrome flags its host needs), then retry" >&2; exit 1; }
      rm -f "$proof"; timeout 120 "$chrome" "${flags[@]}" --screenshot="$proof" "$out" >/dev/null 2>&1 || { echo "Chrome could not screenshot $out" >&2; exit 1; } ;;
    /*) [ -n "$(find "$out" -mmin -10 2>/dev/null)" ] || { echo "$out is not a screenshot taken in the last 10 minutes" >&2; exit 1; }
        proof=$out ;;
    *) echo "usage: pr-steps preflight <app URL> [Chrome flags], or <absolute path of a PNG the session's browser MCP just took of the app>, or 'none, because <why there is no UI or browser-run code>'" >&2; exit 1 ;;
  esac
  case "$proof" in none,*) ;; *) [ "$(head -c8 "$proof" 2>/dev/null | od -An -tx1 | tr -d ' \n')" = 89504e470d0a1a0a ] || { echo "$proof is not a PNG" >&2; exit 1; } ;; esac
  echo "preflight $proof $(date -u +%FT%TZ)" >> "$preflight"
  echo "recorded preflight for branch $(git symbolic-ref --short -q HEAD || echo HEAD): $proof"
  exit 0
fi
# each union head's record names the other's head, the one pre-bash-guard asks for
record_union() { for h in "$1 $2" "$2 $1"; do set -- $h; echo "union $proof $(date -u +%FT%TZ) $2" >> ~/.claude/pr-steps/"$1"; done; echo "recorded union of $1 and $2"; }
if [ "$step" = union ] && [ "$out" = --conflict ]; then
  a=$(git rev-parse HEAD); b=$(git rev-parse -q --verify "${3:?usage: pr-steps union --conflict <the other PR head sha>}^{commit}") || { echo "$3 is no commit here: fetch the other PR's head first" >&2; exit 1; }
  rc=0; git merge-tree --write-tree "$a" "$b" >/dev/null 2>&1 || rc=$?
  [ "$rc" = 1 ] || { echo "HEAD and $3 merge without a conflict: run the quick gates on their merge and record its log with pr-steps union <log>" >&2; exit 1; }
  proof=conflict; record_union "$a" "$b"; exit 0
fi
if [ "$step" = union ]; then
  shas=$(head -n1 "$out" | sed -En 's/^Union: [^ ]+#[0-9]+@([0-9a-f]{7,40}) \+ #[0-9]+@([0-9a-f]{7,40}) on [^ ]+@([0-9a-f]{7,40})$/\1 \2 \3/p')
  [ -n "$shas" ] || { echo "$out's first line is not 'Union: <owner/repo>#<A>@<sha> + #<B>@<sha> on <base>@<sha>'" >&2; exit 1; }
  for s in $shas; do git merge-base --is-ancestor "$s" HEAD 2>/dev/null || { echo "HEAD doesn't hold $s: merge both PRs' heads onto their base, and run the gates there" >&2; exit 1; }; done
  set -- $shas; ua=$(git rev-parse "$1"); ub=$(git rev-parse "$2")
fi
if [ "$step" = approach ]; then
  chosen=$(sed -n 's/^[[:space:]]*Chosen:[[:space:]]*//p' "$out" | head -n1 | sed 's/[[:space:]]*$//')
  [ -n "$chosen" ] || { echo "$out has no line 'Chosen: <candidate>'" >&2; exit 1; }
  grep -Eq '^[[:space:]*>-]*Root cause:[*]*[[:space:]]+(none, .+|.*[A-Za-z0-9_-]*[/.][A-Za-z0-9_./-]*:[0-9]+)' "$out" || { echo "$out has no line 'Root cause: <why it happens, with the path:line that does it>' ('Root cause: none, <what it is>' for a feature or a reshape): rate candidates only once the cause is found, and one of them stops it there (pull-request step 5)" >&2; exit 1; }
  # the Basis line names who asked for this PR: someone else's report, request or agreed design, the user's words, or a
  # failure of the goal's own run; an agent's review, finding or post is no basis for a PR in another project (task §Dispositions)
  basis=$(sed -En 's/^[[:space:]*>-]*Basis:[*]*[[:space:]]+//p' "$out" | head -n1 | sed -E 's/^\[[^]]*\]\(([^)]*)\).*/\1/; s/^<([^>]*)>.*/\1/; s/ → / -> /')
  nobasis="$out has no 'Basis:' line in a form this check reads: 'Basis: <a URL of a report, request or agreed design a person wrote | request: \"<the user's words>\" | goal: <the command the goal runs> -> <its failing output> | clean-cut: <a command on the goal's runtime and tools, at their defaults> -> <its error>>' (pull-request step 5)"
  case "$basis" in
    request:\ ?*|goal:\ ?*\ -\>\ ?*|clean-cut:\ ?*\ -\>\ ?*) ;;
    https://*/-/issues/[0-9]*|https://*/-/merge_requests/[0-9]*) ;;
    https://github.com/*/*/issues/[0-9]*|https://github.com/*/*/pull/[0-9]*)
      u=${basis%%[[:space:]]*}; repo=$(printf '%s' "$u" | cut -d/ -f4,5); n=$(printf '%s' "$u" | cut -d/ -f7 | sed 's/[^0-9].*//'); frag=${u#*#}; [ "$frag" = "$u" ] && frag=
      case "$frag" in
        issuecomment-*) api=repos/$repo/issues/comments/${frag#issuecomment-} ;;
        discussion_r*|r[0-9]*) api=repos/$repo/pulls/comments/${frag##*r} ;;
        pullrequestreview-*) api=repos/$repo/pulls/$n/reviews/${frag#pullrequestreview-} ;;
        *) api=repos/$repo/issues/$n ;;
      esac
      kind=$(gh api "$api" --jq .user.type 2>/dev/null) && [ -n "$kind" ] || { echo "Basis $u: gh api $api failed, so its author is unknown" >&2; exit 1; }
      # an agent's post (its badge, writing §Forms) or a bot's is our own finding, whichever account posted it
      body=$(gh api "$api" --jq .body 2>/dev/null); case "$kind ${body:0:2000}" in Bot\ *|*'src="https://github.com/claude.png"'*|*'src="https://github.com/openai.png"'*) false ;; esac || { echo "Basis $u was written by an agent or a bot: name a report, request or agreed design a person wrote, the user's words as 'request: \"<them>\"', or the goal's own failing run (task §Dispositions)" >&2; exit 1; } ;;
    *) echo "$nobasis" >&2; exit 1 ;;
  esac
  # candidates: table rows `| name | rating 0-10 | why |`; the header and separator rows have no numeric rating
  rows=$(awk -F'|' '/^[[:space:]]*\|/ { for (i=1;i<=NF;i++) gsub(/^[[:space:]]+|[[:space:]]+$/,"",$i); if ($3 ~ /^([0-9]|10)(\/10)?$/ && $2 != "" && $4 != "") { sub(/\/10$/,"",$3); print tolower($2) "\t" $3 } }' "$out")
  [ "$(printf '%s' "$rows" | grep -c .)" -ge 2 ] || { echo "$out lists fewer than two rated candidates: a table '| Candidate | Rating | Why |' with each candidate, not building it included, rated 0-10 with its reason" >&2; exit 1; }
  rating=$(printf '%s\n' "$rows" | awk -F'\t' -v c="$(printf '%s' "$chosen" | tr 'A-Z' 'a-z')" '$1==c {print $2; exit}')
  [ -n "$rating" ] || { echo "Chosen '$chosen' is not a row of the candidates table" >&2; exit 1; }
  [ "$rating" -ge 7 ] || { echo "the chosen approach is rated $rating: 6 or below is not ready to build (pull-request step 5); find a better candidate or stop" >&2; exit 1; }
  grep -Eq '^[[:space:]*>-]*Shared assumption:[*]*[[:space:]]+[^[:space:]]+[[:space:]]+[^[:space:]]+' "$out" || { echo "$out has no line 'Shared assumption: <what every other candidate takes for granted>', which one candidate drops (pull-request §Rating)" >&2; exit 1; }
  grep -Eq '^[[:space:]*>-]*Probe:[*]*[[:space:]]+[^[:space:]].*[[:space:]]->[[:space:]]*[^[:space:]]' "$out" || { echo "$out has no line 'Probe: <the run that tried to break the shared assumption> -> <its result>': run one before Chosen (pull-request step 5)" >&2; exit 1; }
  # the contract is the one this session's loaded skills follow (session-start's record): a session on v1's catalog, or one
  # with no record, still records loopb and refactor, so its branch gets no `contract: 2`
  catalog=$(cut -d' ' -f2 ~/.mergeworthy/sessions/"$(basename "${CLAUDE_CODE_SESSION_ID:-none}")" 2>/dev/null || true)
  echo "approach $(realpath "$out") $(date -u +%FT%TZ)$([ "$catalog" = graph ] && echo ' contract: 2')" >> "$approach"
  echo "recorded approach for branch $(git symbolic-ref --short -q HEAD || echo HEAD)"
  exit 0
fi
[ -s "$out" ] || { echo "$out is empty: run the step and save its output" >&2; exit 1; }
last=$(grep -v '^[[:space:]]*$' "$out" | tail -n1 || true)
sha=$(git rev-parse HEAD)
# the PR's own base, its parent branch when it is stacked: what the branch changes is measured from it
pbase() {
  local pb; pb=$(gh pr view --json baseRefName -q .baseRefName 2>/dev/null || true)
  git merge-base HEAD "${pb:+origin/$pb}" 2>/dev/null || git merge-base HEAD "$(git symbolic-ref -q --short refs/remotes/origin/HEAD || echo origin/main)" 2>/dev/null || true
}
# drift_note <step>: the step's note on $sha, its kind once and a finality's plan line; the repo's notes.rewriteRef gets the drift ref beside
# any value it has, which is what makes an amend or a rebase copy the note. A note it can't write exits, recording nothing
drift_note() {
  local ref k m=; read -r ref k <<< "$(python3 "$(dirname "$(realpath "$0")")/../hooks/records.py" drift-note "$1")"; [ -n "$k" ] || return 0
  local failed="the drift note of $out on $sha could not be written (git's error above), so nothing is recorded: fix that, then run the same pr-steps again"
  # the repo's own value: a global one is the recorder's alone, which another home amending this checkout doesn't have
  if ! git config --local --get-all notes.rewriteRef | grep -qxF "$ref"; then git config --local --add notes.rewriteRef "$ref" || { echo "$failed" >&2; exit 1; }; fi
  git notes --ref="$ref" show "$sha" 2>/dev/null | grep -qxF "$k" || m=$k
  # a finality's plan size: the changes past LIMIT hooks/drift.py lets the files the branch changed take; a later plan's line wins
  if [ "$k" = finality ]; then m+=${m:+$'\n'}"plan $plan"; fi
  [ -n "$m" ] || return 0
  # a note is a commit, which needs an identity: pr-steps' own, which no half-set or useConfigOnly identity can fail
  git -c user.name=pr-steps -c user.email=pr-steps@localhost notes --ref="$ref" append -m "$m" "$sha" || { echo "$failed" >&2; exit 1; }
}
# record <step> <line>...: records $out on $sha as a line per step named, after its drift note as <step>; an output recorded already is refused
record() {
  local step=$1; shift
  grep -qsF " $(realpath "$out") " ~/.claude/pr-steps/"$sha" && { echo "$out is already recorded for $sha: each step has its own output" >&2; exit 1; }
  drift_note "$step"
  for k in "$@"; do echo "$k $(realpath "$out") $(date -u +%FT%TZ)" >> ~/.claude/pr-steps/"$sha"; done
}
# build output, not code a reviewer reads: those of the paths on stdin, a line each, that testpaths.generated finds
built() { python3 "$(dirname "$(realpath "$0")")/../hooks/testpaths.py" generated; }
# numstat lines on stdin (core.quotePath=false: check-attr reads the path as it is) whose path (field 3) isn't build output
not_built() { local ns; ns=$(cat); printf '%s\n' "$ns" | G=$(printf '%s\n' "$ns" | cut -f3 | built) awk -F'\t' 'BEGIN { split(ENVIRON["G"], a, "\n"); for (i in a) g[a[i]] } NF && !($3 in g)'; }
# pr-steps small <report>: a fix of at most 60 lines outside tests, docs, lockfiles and build output, with a test in the diff (a diff of docs
# or code comments alone: a commit's Cold-read trailer, rules step 4), reviewed once by delegate/small-review.md, stands for verify, shape,
# reverify and fresh (converge §Small fix); gates still run
if [ "$step" = small ]; then
  base=$(pbase); [ -n "$base" ] || { echo "no merge-base with the base branch" >&2; exit 1; }
  testre=$(python3 "$(dirname "$(realpath "$0")")/../hooks/testpaths.py")
  docs='\.md$|(^|/)docs?/'
  skip=$(python3 "$(dirname "$(realpath "$0")")/../hooks/testpaths.py" not-code)
  n=$(git -c core.quotePath=false diff --numstat "$base" HEAD | not_built | awk -F'\t' -v r="$skip" '$3 !~ r {s+=$1+$2} END{print s+0}')
  [ "$n" -le 60 ] || { echo "$n changed lines outside tests, docs, lockfiles and build output (dist/, linguist-generated): past a small fix's 60, run converge steps 1-4" >&2; exit 1; }
  if ! git diff --name-only --diff-filter=AM "$base" HEAD | grep -Eq "$testre"; then
    # the first changed line that isn't blank or a whole-line comment (//, /*, *, # , -- , <!--), or a binary file: comments alone are docs
    code=$(git diff --numstat "$base" HEAD | awk -v r="$docs" '$3 !~ r && $1 == "-" {print "binary " $3; exit}')
    [ -n "$code" ] || code=$(git diff --name-only "$base" HEAD | grep -Ev "$docs" | xargs -r -d '\n' git diff -U0 "$base" HEAD -- | grep -E '^[-+]' \
      | grep -Ev '^(\+\+\+|---) (a/|b/|/dev/null)' | grep -Ev '^[-+][[:space:]]*(//|/\*|\*([[:space:]/]|$)|(#|--)([[:space:]]|$)|<!--|$)' | head -n1 || true)
    # a repo whose habit keeps no PR-proving test (code §Tests): the review's reproduction, red on this base and green on this head
    repro=$(sed -nE 's/^[[:space:]*>-]*Reproduction:.*: red on ([0-9a-f]{7,40}), green on ([0-9a-f]{7,40})[.[:space:]]*$/\1 \2/p' "$out" | head -n1)
    if [ -n "$code" ] && ! { [ -n "$repro" ] && [[ $base == "${repro% *}"* && $sha == "${repro#* }"* ]]; }; then
      echo "the diff adds or changes no test: a small fix carries a test that fails on the base and passes on the head, or, where the repo keeps no such test, its report a line 'Reproduction: <command>: red on <base sha>, green on <head sha>' for $(git rev-parse --short "$base") and $(git rev-parse --short HEAD) (a code line: $code)" >&2; exit 1
    fi
    [ -n "$code" ] || python3 "$(dirname "$(realpath "$0")")/../.githooks/cold-read" "$base..HEAD" || { echo "the diff changes only docs or code comments and has no cold read: a commit of it carries a 'Cold-read: <path>' trailer naming the cold read's record (mergeworthy:rules step 4)" >&2; exit 1; }
  fi
  # the verdict ends the report, before any trailing Verification or not_checked section (delegate/agent.md asks every agent for not_checked)
  verdict=$(awk '{ l = tolower($0) } l ~ /^#+[ \t]*(verification|not[ _]checked)([^a-z]|$)/ { tail = 1; next } /^#/ { tail = 0 } !tail' "$out" | grep -v '^[[:space:]]*$' | tail -n2 | tr '\n' '|')
  [ "$(grep -v '^[[:space:]]*$' "$out" | tail -n2 | tr '\n' '|')" = 'NO BUGS|MERGE AS IS: yes|' ] || [ "$verdict" = 'NO BUGS|MERGE AS IS: yes|' ] || ledger_ok || { echo "$out does not end with NO BUGS and MERGE AS IS: yes: fix what it found and send the same reviewer round 2 checking that fix; after round 2, record it with --ledger <the loop's ledger>" >&2; exit 1; }
  record small verify shape reverify fresh
  echo "recorded small fix ($n lines) for $sha: verify, shape, reverify, fresh; run the gates next"
  exit 0
fi
# A shape record is the pass's lists (the ✅ coverage list and old ⇒ new ratings) ending CLEAN, or a small follow-up that
# carries an earlier pass or small fix's review ("carries the pass of <sha>", carry_holds): a fix log or a note is not a shape pass
# A pass rates every item afresh: a row whose rating is copied ("10 =", "=", "unchanged since") is a re-rating of a delta, not a pass
is_pass() { grep -q '✅' "$1" && grep -Eq '([0-9]+|\bnew) *(⇒|=>) *([0-9]+|removed|new|n/a)' "$1" && ! grep -Eiq '\| *([0-9]+ *)?= *\||unchanged since' "$1"; }
# The lines between two trees, a binary, mode or empty file counting one
span() { git diff --numstat "$1" "$2" | awk '{ s += $1 + $2 + 1 } END { print s + 0 }'; }
# The file of each line HEAD changed since an earlier head, once per line: compared whole with that head replayed on the base HEAD has merged,
# so what the base brought doesn't count and every move does; a conflict stays in the replay as its markers, so its resolution counts
delta() {
  local b c d h k m n pb M T r=
  b=$(pbase); pb=$(gh pr view --json baseRefName -q .baseRefName 2>/dev/null || true)
  [ -n "$pb" ] || { pb=$(git symbolic-ref -q --short refs/remotes/origin/HEAD || true); pb=${pb#origin/}; }
  m=$(git merge-base "$b" "$1" 2>/dev/null || true)
  # a squash of a branch $1 merged leaves git no merge base inside it: replay from the commit of $1 nearest the base that a merged PR's head
  # shares with it, which holds that branch; only PRs merged into this PR's base branch count; gh failing leaves the merge base
  if [ -n "$m" ]; then n=$(span "$m" "$b")
    for h in $(gh pr list --state merged --base "${pb:-main}" --limit 30 --json headRefOid -q '.[].headRefOid' 2>/dev/null || true); do
      c=$(git merge-base "$1" "$h" 2>/dev/null) && ! git merge-base --is-ancestor "$c" "$b" || continue
      k=$(span "$c" "$b"); [ "$k" -ge "$n" ] || { n=$k; r=$c; }
    done
  fi
  M=$(git -c core.quotePath=false merge-tree --write-tree --name-only ${r:+--merge-base="$r"} "$b" "$1" 2>/dev/null || true)  # exit 1 on a conflict, with the tree first, then the conflicted files
  [ -n "$M" ] || [ -z "$r" ] || M=$(git -c core.quotePath=false merge-tree --write-tree --name-only "$b" "$1" 2>/dev/null || true)  # a git without --merge-base replays as before
  T=$(sed -n 1p <<< "$M"); d=$(git -c core.quotePath=false -c diff.noprefix=false diff --no-renames --numstat "${T:-$1}" HEAD |
    not_built | awk -F'\t' '{ n = $1 + $2; if (!n) n = 1; for (i = 0; i < n; i++) print $3 }')  # a binary, a mode or an empty file has no line, and is a change
  printf '%s\n' "$d"
  sed -n '2,/^$/p' <<< "$M" | grep -vxF -e "$d" -e '' | sed 's/^/0\t0\t/' | not_built | cut -f3 || true  # a conflict whose written tree has no markers (modify/delete) still changed its file
}
# A carry of head $1's step holds for at most 80 changed lines, none outside tests and docs: a line of code may add behavior, whatever the session says
carry_holds() {
  local files changed code
  files=$(delta "$1"); changed=$(printf '%s' "$files" | grep -c . || true)
  [ "$changed" -le 80 ] || { echo "$changed lines changed since $1: too much to carry, run the $step step again (mergeworthy:converge §Batching)" >&2; exit 1; }
  code=$(printf '%s\n' "$files" | R="$(python3 "$(dirname "$(realpath "$0")")/../hooks/testpaths.py")|[.]md\$" awk 'NF && $0 !~ ENVIRON["R"] && !f {f = $0} END {print f}')
  [ -z "$code" ] || { echo "$code changed since $1, and a carry holds for tests and docs alone: run the $step step again (mergeworthy:converge §Batching)" >&2; exit 1; }
}
# A small follow-up (carry_holds) carries an earlier head's recorded step: "carries the pass of <sha>"
carries() {
  c=$(grep -Eo 'carries the pass of [0-9a-f]{7,40}' "$out" | head -n1 | awk '{print $NF}' || true); [ -n "$c" ] || return 1
  full=$(git rev-parse "$c" 2>/dev/null) || { echo "$c is not a commit" >&2; exit 1; }
  awk -v s="$step" '$1==s' ~/.claude/pr-steps/"$full" 2>/dev/null | grep -q . || { echo "$c has no recorded $step to carry" >&2; exit 1; }
  carry_holds "$full"
}
if [ "$step" != shape ] && [ "$step" != refactor ] && [ "$step" != gates ] && [ "$step" != quick ] && [ "$step" != union ] && [ "$step" != finality ] && [ "$step" != layout ] && carries; then :; else
base=$(git merge-base HEAD "$(git symbolic-ref -q --short refs/remotes/origin/HEAD || echo origin/main)" 2>/dev/null || true)
case "$step" in
  verify|reverify)
    [ "$last" = "NO BUGS" ] || [ "$step" = reverify -a "$last" = "NO LOOP B COMMITS" ] || ledger_ok || { echo "$out does not end with a line NO BUGS: fix what it found for round 2; after round 2, record it with --ledger <the loop's ledger>" >&2; exit 1; }
    [ "$step" = reverify ] || read_standards
    # A reproduced behavior dropped as harmless, and a claim no test or probe covers, are the main session's call: a later `RULED: <candidate>: <ruling>` line, its own
    unruled=$(python3 - "$out" "$(pbase)" "$(dirname "$(realpath "$0")")/../hooks" <<'EOF'
import re, sys
sys.path.insert(0, sys.argv[3])
import main_too
lines, clean = open(sys.argv[1]).read().splitlines(), lambda l: re.sub(r'[*`]', '', l).strip()
plain = lambda l: clean(l).lower()
item = re.compile(r'(\s*)([-*+]|\d+\.)\s')
# each ruled list's outermost item indentation: a deeper item is a sub-bullet, covered by its item's RULED line
# only the dropped and untested-claims lists: a counted bug may well be "a rare race"
ruled = lambda l: 'dropped' if 'dropped' in l.lower() else 'claims' if 'untested claims' in l.lower() else None
sec, outer, kind = None, {}, {}
for i, l in enumerate(lines):
    if l.startswith('#'): kind[i] = ruled(l); sec = i if kind[i] else None
    elif sec is not None and (m := item.match(l)): outer[sec] = min(outer.get(sec, len(l)), len(m[1]))
sep, bare = r':|\s[—–-]\s', lambda l: re.sub(r'^[\s>+-]*(\d+\.\s*)?', '', plain(l))
# a candidate named by a line reference ('- :67 now says …', '- agent.md:10 …') is ruled as 'RULED: :67: …'
name_of = lambda l: (re.match(r'\S*:\d+(-\d+)?', bare(l)) or re.split(sep, bare(l), maxsplit=1))[0].strip()
# an untested claim, '<claim> — <runtime> — <probe> — <result>' (delegate/verifier.md), is ruled under its claim
claim_of = lambda l: re.split(r'\s[—–]\s', bare(l), maxsplit=1)[0].strip()
# 'None.', 'Nothing was dropped.': an unbulleted line whose first sentence is one of these says the list is empty
empty = lambda l: not item.match(l) and \
    re.fullmatch(r'none|nothing|nothing( was)? dropped|no candidates? dropped|no candidates were dropped', re.split(r'\.(?:\s|$)', bare(l), maxsplit=1)[0].strip())
# a ruling's lines: its RULED line and the indented lines right after it, up to a blank or unindented line or a list item; text[j] joins them
text, own = {}, set()
for j, r in enumerate(lines):
    if not r.startswith('RULED:'): continue
    k = j + 1
    while k < len(lines) and lines[k][:1] in (' ', '\t') and lines[k].strip() and not item.match(lines[k]): k += 1
    text[j] = ' '.join(x.strip() for x in lines[j:k]); own.update(range(j, k))
sec, items = None, []
for i, l in enumerate(lines):
    if l.startswith('#'):
        sec = i if kind[i] else None
        continue
    # a candidate: an outermost list item, or an unbulleted '<candidate>: <why>' line; under untested claims, any unbulleted line
    m, claims = item.match(l), kind.get(sec) == 'claims'
    if sec is not None and l.strip() not in ('', 'NO BUGS', 'NO LOOP B COMMITS') and (len(m[1]) == outer[sec] if m else claims or re.match(r'[^:]+:\s', plain(l))) and not empty(l) and i not in own:
        items.append((i, l, (claim_of if claims else name_of)(l)))
# a RULED line rules one earlier item: of those whose 'RULED: <name>:' it starts with, the longest name (one not yet ruled first),
# so 'RULED: focus stays: after navigation: …' rules that claim and never 'focus stays' too
rulings = {i: [] for i, _, _ in items}
for j, r in text.items():
    hits = [(len(n), -len(rulings[i]), i, m.end()) for i, _, n in items if i < j and n and (m := re.match(r'ruled:\s*' + re.escape(n) + r'\s*:', plain(r)))]
    if hits: _, _, k, end = max(hits); rulings[k].append(clean(r)[end:])  # the ruling's own text, after its candidate
for i, l, name in items:
    if not rulings[i]:
        print(l)
    # 'main has it too' excuses a defect only where it comes from outside the functions this branch changes: the ruling names that path:line
    elif all((bad := main_too.excuse(why, sys.argv[2])) for why in rulings[i]):
        print(l + f"  <- main having it excuses nothing here: {bad}. Start the ruling 'a bug', name the path:line the defect comes from, outside the functions this branch changes, or say why no user meets it (code Earn every line, no realistic usage)")
EOF
)
    [ -z "$unruled" ] || { printf '%s\n' "every dropped candidate and untested claim goes to the main session, which rules on it in a later line 'RULED: <candidate>: <ruling>' (mergeworthy delegate/verifier.md, What counts):" "$unruled" >&2; exit 1; }
    # A diff that touches bodies, buffers, streams or cancellation gets code §No regressions' list answered item by item
    if [ "$step" = verify ] && [ -n "$base" ] && git diff "$base" HEAD | grep -Eq '^\+.*(ReadableStream|WritableStream|TransformStream|arrayBuffer\(|\.bytes\(|\.body\b|bodyUsed|\btee\(|\.clone\(|AbortSignal|AbortController|ArrayBuffer|(Int|Uint|Float|BigInt|BigUint)[0-9]+Array|Buffer\.|defineProperty|prototype\.[A-Za-z_]+ *=)'; then
      sec=$(awk '/^## Bodies and streams/{f=1;next} /^## /{f=0} f' "$out")
      miss=$(for w in Cancellation Backpressure Cap Release 'Read once' Ownership Failure Sources 'Second copy'; do printf '%s\n' "$sec" | grep -Eqi "^- \*{0,2}$w\*{0,2}: +[^ ]+ +[^ ]+ +[^ ]+" || printf '%s, ' "$w"; done)
      [ -z "$miss" ] || { echo "the diff touches bodies, buffers, streams or cancellation: $out needs '## Bodies and streams' with a line '- <item>: <the probe run and what it showed>' (or 'not reached, because <reason>') for each item of code §No regressions' first bullet; missing or too short: ${miss%, }" >&2; exit 1; }
    fi ;;
  layout)
    bad=$(python3 "$(dirname "$(realpath "$0")")/../hooks/main_too.py" layout "$out" "$(pbase)") ||
      { printf '%s\n' "$out is a layout check, one line per screenshot: '<file name> — OK', or a defect left unfixed as '<file name> — <the defect>, from <path:line>', the place it comes from, outside the functions this branch changes (mergeworthy:evidence step 4):" "$bad" >&2; exit 1; } ;;
  finality)
    # finality step 3: a code file's 6th change on the branch waits for this record (pre-bash-guard)
    # its 'Plan:' steps, numbered 1, 2, 3… until a number out of turn, which drift_note writes into the finality's note
    plan=$(awk '/^Plan:/{p=1;next} p&&/^[0-9]+\. +[^ ]/{if ($0+0 != n+1) exit; n++} END{print n+0}' "$out")
    grep -Eq '^Pinnacle: +[^ ]+ +[^ ]+ +[^ ]+' "$out" && [ "$plan" -gt 0 ] ||
      { echo "$out needs a line 'Pinnacle: <the design>' and a line 'Plan:' followed by the ranked convergence plan, one numbered line '1. <step>' per step (mergeworthy finality step 3)" >&2; exit 1; } ;;
  loopb)
    [ "$last" = CLEAN ] || { echo "$out does not end with a line CLEAN: fix its findings and continue the same agent" >&2; exit 1; } ;;
  fresh)
    read_standards
    grep -Eq '^Maintainer: @?[A-Za-z0-9-]+' "$out" || old_pipeline || { echo "$out has no line 'Maintainer: <login>': the fresh reader reviews as the maintainer who decides, citing what they said or did (mergeworthy delegate/fresh-reader.md)" >&2; exit 1; }
    grep -qx 'MERGE AS IS: yes' "$out" || ledger_ok || { echo "$out has no line 'MERGE AS IS: yes': the fresh reader, as this repo's maintainer, would not merge it exactly as it is; what it lists stands between the PR and a yes, until round 2's ledger closes it (--ledger <path>)" >&2; exit 1; }
    # a yes is the maintainer merging this head: a note it adds (a body word) goes through the body's post review, no new reader
    ;;
  shape|refactor)
    if is_pass "$out"; then
      [ "$step" = refactor ] || old_pipeline || read_standards
      [ "$step" = refactor ] ||
      [ "$last" = CLEAN ] || ledger_ok || { echo "$out does not end with a line CLEAN: land what its review and shape pass found worth changing, then continue the same agent for round 2; after round 2, record it with --ledger <the loop's ledger> (mergeworthy:converge step 2)" >&2; exit 1; }
    else
      carried=$(grep -Eo 'carries the pass of [0-9a-f]{7,40}' "$out" | head -n1 | awk '{print $NF}' || true)
      copied=$(grep -Eio '\| *([0-9]+ *)?= *\||unchanged since' "$out" | head -n1 || true)
      [ -n "$carried" ] || [ -z "$copied" ] || { echo "$out is not a shape pass: a row's rating is copied ('$copied'); rate every file and function afresh as old ⇒ new, with the reason in your own words (mergeworthy delegate/shape.md)" >&2; exit 1; }
      lacks=$(grep -q '✅' "$out" || printf 'the ✅ coverage list, '; grep -Eq '([0-9]+|\bnew) *(⇒|=>) *([0-9]+|removed|new|n/a)' "$out" || printf 'old ⇒ new ratings, '
              grep -q '^## Standards read' "$out" || printf "'## Standards read', "; [ "$last" = CLEAN ] || printf 'a last line CLEAN, ')
      [ -n "$carried" ] || { echo "$out is not a shape pass: it lacks ${lacks%, } (mergeworthy delegate/shape.md). A pass that changes nothing is one too: it rates each item N ⇒ N and records on the unchanged head. A small follow-up says 'carries the pass of <sha>' instead: it carries the latest pass recorded on <sha>, unless a maintainer asked for a pass after it" >&2; exit 1; }
      full=$(git rev-parse "$carried")
      rec=~/.claude/pr-steps/"$full"
      # the latest pass recorded on that head (records are appended in time order); no pipeline that a `head` could close early
      prev=; while read -r f; do if is_pass "$f"; then prev=$f; fi; done < <(awk -v s="$step" '$1=="shape"||$1==s{print $2}' "$rec" 2>/dev/null)
      # an old head's refactor pass stands for a shape pass only with its Loop B review: a loopb record ending CLEAN
      if [ -z "$prev" ] && [ "$step" = shape ]; then
        loopb=; while read -r f; do if [ "$(grep -v '^[[:space:]]*$' "$f" 2>/dev/null | tail -n1)" = CLEAN ]; then loopb=$f; fi; done < <(awk '$1=="loopb"{print $2}' "$rec" 2>/dev/null)
        if [ -n "$loopb" ]; then while read -r f; do if is_pass "$f"; then prev=$f; fi; done < <(awk '$1=="refactor"{print $2}' "$rec"); fi
      fi
      # a small fix's review, recorded by pr-steps small for verify, shape, reverify and fresh alike, is that head's shape record (converge §Small fix)
      [ -n "$prev" ] || [ "$step" != shape ] ||
        prev=$(awk '$1 ~ /^(verify|shape|reverify|fresh)$/ && !seen[$1 FS $2]++ && ++n[$2] == 4 {f = $2} END {print f}' "$rec" 2>/dev/null)
      [ -n "$prev" ] || { echo "$carried has no recorded shape pass with ratings, nor a small fix's review, to carry" >&2; exit 1; }
      # a maintainer's ask for a refactor pass (the watcher's refactor-asks.txt: time, the PR's head then, the PR, the comment) made on
      # this branch after the carried pass is answered by a pass, not a carry
      at=$(awk -v f="$prev" '$2==f{t=$3} END{print t}' "$rec")
      ask=$(while read -r t h _ u; do [[ "$t" > "$at" ]] && git merge-base --is-ancestor "$h" HEAD 2>/dev/null && echo "$u"; done < <(cat ~/.claude/refactor-asks.txt 2>/dev/null) | tail -n1 || true)
      [ -z "$ask" ] || { echo "$ask asks for a refactor pass after the pass $carried carries ($at): run the pass on this head (mergeworthy:converge step 2, delegate/shape.md) and record its report, not a carry" >&2; exit 1; }
      carry_holds "$full"
    fi ;;
  gates|quick|union)
    grep -Eq '^.+ -> exit [0-9]+( \([0-9]+ (tests?|projects?|files?|words)\))?$' "$out" || { echo "$out lists no gate: one line per gate, '<command> -> exit <code>', run on this HEAD; a test gate: '<command> -> exit 0 (<N> tests)'" >&2; exit 1; }
    # a gate that can't run here is installed or run another way: CI is never where a change is first checked
    unrun="\\b(not installed|isn't installed|let CI|leave it to CI|CI will (verify|check|tell)|(can't|cannot|can not) (run|install)|(not|wasn't|weren't) run)\\b"
    # read on every line but a suite's test results, whose titles may quote these words: '<title>: <got> (want <want>)', ok/PASS/✓ lines
    # nor inside quoted text (`…`, "…", '…', /…/: a test's message), nor where the base is the phrase's subject ('base 70490e389 was not run')
    own=$(grep -Ev '\(want .*\)$|^[[:space:]]*(ok|not ok|PASS|FAIL|✓|✔|✗|×)[[:space:]]' "$out" |
      sed -E "s/([[:alpha:]])'([[:alpha:]])/\1\x01\2/g; s/\`[^\`]*\`|\"[^\"]*\"//g; s/(^|[[:space:]([{])'[^']*'([[:space:][:punct:]]|\$)/\1\2/g; s/\x01/'/g; s#(^|[[:space:]])/[^/]+/([[:space:][:punct:]]|\$)#\1\2#g; s#\b(base|main)[[:space:]]+[0-9a-f]{7,40}([[:space:]]+(was|were|is|has been))?[[:space:]]+$unrun##Ig" || true)
    ! printf '%s\n' "$own" | grep -Eiq "$unrun" || { echo "$out says a gate didn't run ($(printf '%s\n' "$own" | grep -Eio "$unrun" | head -n1)): install what it needs and run it (code §Gates)" >&2; exit 1; }
    gl=$(grep -E ' -> exit [0-9]+' "$out" || true)
    ! grep -Eq ' -> exit [1-9][0-9]*( \(.*\))?$' "$out" || { echo "$out has a red gate: fix it on this HEAD first" >&2; exit 1; }
    # a gate that ran nothing is red (a filter that matched nothing): a test-named line ends with a count over 0, and no line counts 0
    bad=$( { printf '%s\n' "$gl" | grep -Ei '(^|[ /:])(test|tests|e2e|vitest|jest|playwright|mocha|pytest|bun test)([ :/-]|$)' | grep -Ev '\(([1-9][0-9]*) (tests?|projects?|files?|words)\)$'
             printf '%s\n' "$gl" | grep -E '\(0+ (tests?|projects?|files?|words)\)$'; } | head -n3 || true)
    [ -z "$bad" ] || { echo "a test gate in $out has no '(N tests)' with N > 0, so it may have run nothing (code §Gates); a type check ends with '(N projects)', a lint or format check with '(N files)', a gate that counts words with '(N words)'; the wanted line: '<command> -> exit 0 (<N> tests)': $bad" >&2; exit 1; }
    # a changeset is a sentence or two on what changed for users, naming every package whose files the branch changed (a maintainer's ask)
    if [ -n "$base" ] && [ -d "$(git rev-parse --show-toplevel)/.changeset" ]; then
      bad=$(cd "$(git rev-parse --show-toplevel)" && python3 - "$base" <<'EOF'
import json, os, re, subprocess, sys
diff = lambda *a: [f for f in subprocess.run(['git', 'diff', '--name-only', *a], capture_output=True, text=True).stdout.splitlines() if f]
sets, named = [f for f in diff('--diff-filter=AM', sys.argv[1], 'HEAD', '--', '.changeset/*.md') if f != '.changeset/README.md'], set()
for f in sets:
    m = re.match(r'---\n(.*?)^---\n?(.*)', open(f).read(), re.M | re.S)
    front, body = m.groups() if m else ('', open(f).read())
    named |= set(re.findall(r'^\s*["\']?([^"\'\s:]+)["\']?\s*:', front, re.M))
    if len(body.split()) > 60:
        print(f"{f}: its body has {len(body.split())} words, at most 60 (a sentence or two on what changed for users)")
pkgs = set()
for f in diff(sys.argv[1], 'HEAD') if sets else ():
    d = os.path.dirname(f)
    while d and not (os.path.isfile(os.path.join(d, 'package.json')) and json.load(open(os.path.join(d, 'package.json'))).get('name')):
        d = os.path.dirname(d)
    if d and not (j := json.load(open(os.path.join(d, 'package.json')))).get('private'):
        pkgs.add(j['name'])
if pkgs - named:
    print("the changesets name no bump for " + ', '.join(sorted(pkgs - named)) + ", whose files the branch changed")
EOF
)
      [ -z "$bad" ] || { echo "$bad" >&2; exit 1; }
    fi ;;
esac
fi
[ "$step" != union ] || { proof=$(realpath "$out"); record_union "$ua" "$ub"; exit 0; }
record "$step" "$step"
echo "recorded $step for $sha"
