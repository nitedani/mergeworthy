#!/usr/bin/env bash
# pr-steps <read|review> <output-file>: records that a fresh reader answered that question (mergeworthy:ready) on the current HEAD.
# pre-bash-guard blocks `gh pr create` (unless --draft) and `gh pr ready` until HEAD has a read and a review record.
set -euo pipefail
kind=${1:?usage: pr-steps <read|review> <output-file>}; out=${2:?output file}
case "$kind" in read|review) ;; *) echo "kind must be read or review" >&2; exit 1;; esac
[ -s "$out" ] || { echo "$out is empty: save the reader's final message there" >&2; exit 1; }
sha=$(git rev-parse HEAD)
mkdir -p ~/.claude/pr-steps
echo "$kind $(realpath "$out") $(date -u +%FT%TZ)" >> ~/.claude/pr-steps/$sha
echo "recorded $kind for $sha"
