#!/usr/bin/env python3
"""thread-context <owner/repo#N | gitlab.com/<path>!N or #N | issue/PR/MR/discussion URL> [--depth 2] [--max 30] [--out <file>]: the whole record a reply must be drafted from.
Fetches the thread (body, issue comments, PR review comments and reviews, a GitHub Discussion's comments and replies, or a GitLab issue's
or MR's notes, each with author, time and permalink; GitHub through gh, GitLab through glab) and every thread it links (owner/repo#N, bare #N,
a GitLab thread's !N and <path>!N, github.com and gitlab.com issue/PR/MR/discussion URLs), breadth-first to --depth, at most --max threads, skipping bots.
Writes one markdown file (default ./thread-context.md): a header (root, latest human comment, threads), a ledger of the humans'
agreements, rejections, proposals and decisions, the root transcript, then the linked transcripts (last 30 comments each).
Threads are cached by updated_at under ~/.cache/mergeworthy/threads/.
  thread-context --latest <repo#N>     print "<id> <time>" of the thread's latest human comment
  thread-context --ref <ref>           print the owner/repo#N (or GitLab reference) a reference or URL names, an organization's discussion URL too
  thread-context --items <ref>         print the thread's records (body, comments, replies, reviews) as JSON, in time order
  thread-context --verify <file> [--target <repo#N>] [--parent <file>]
                                       exit 1 with the reason unless <file> is for the target thread and records its current latest
                                       human comment (checked against its root when the parent comment is newer than <file>)"""
import json, os, re, subprocess, sys, datetime, urllib.parse
from concurrent.futures import ThreadPoolExecutor
sys.path[:0] = [os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), d) for d in ('watcher', 'hooks')]
import gl_watch  # BADGE: what an agent's post starts with
from post_words import uncoded

LINKED_LAST = 30          # comments kept per linked thread
LINKED_BODY = 4000        # characters kept per comment in a linked thread
CACHE = os.path.expanduser('~/.cache/mergeworthy/threads')
USAGE = "usage: thread-context <owner/repo#N | gitlab.com/<path>!N | discussion URL> [--depth 2] [--max 30] [--out <file>] | --latest <repo#N> | --ref <ref> | --items <ref> | --verify <file> [--target <repo#N>] [--parent <file>]"

def die(msg, code=1):
    print(msg, file=sys.stderr); sys.exit(code)

def api_json(path, paginate=False, cmd=('gh', 'api'), args=()):
    """JSON from `<cmd> <path> <args>`, gh api by default (pages flattened into one list); None when the call fails (404, offline)."""
    cmd = [*cmd, path, *args] + (['--paginate'] if paginate else [])
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if r.returncode != 0: return None
    dec, s, i, out = json.JSONDecoder(), r.stdout, 0, []
    while i < len(s):
        while i < len(s) and s[i].isspace(): i += 1
        if i >= len(s): break
        try: v, i = dec.raw_decode(s, i)
        except ValueError: return None
        out += v if isinstance(v, list) else [v]
    return out if paginate else (out[0] if out else None)

class Unreadable(Exception):
    """A request load() needs failed: the thread can't be read whole, so nothing is recorded or cached from it."""

def fetch(path, paginate=False, cmd=('gh', 'api'), args=()):
    """api_json, raising Unreadable (naming the request) when the call fails."""
    v = api_json(path, paginate, cmd, args)
    if v is None: raise Unreadable(f'`{" ".join(cmd)} {path}` failed')
    return v

def is_bot(u):
    u = u or {}
    return u.get('type') == 'Bot' or (u.get('login') or '').endswith('[bot]')

def utc(at):
    """at as the record writes every time: YYYY-MM-DDTHH:MM:SSZ in UTC, whatever form GitHub or GitLab returned (GitLab's
    2022-01-31T15:10:44.988Z, an offset); '' when there is none, at itself when it isn't a time."""
    try: return datetime.datetime.fromisoformat(at).astimezone(datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ') if at else ''
    except ValueError: return at

def record(kind, c, at_key='created_at', extra=''):
    u = c.get('user') or {}
    body = c.get('body') or ''
    return {'kind': kind, 'id': c.get('id') or 0, 'author': u.get('login') or 'ghost', 'bot': is_bot(u), 'agent': bool(gl_watch.BADGE.match(body)),
            'at': utc(c.get(at_key) or c.get('created_at') or ''), 'url': c.get('html_url') or '', 'body': body, 'extra': extra}

def load(repo, sep, num):
    """The thread as {ref, title, url, state, is_pr, updated_at, items:[record...]}, cached by updated_at; Unreadable when a request
    for it fails (it doesn't exist, or the service is down)."""
    if repo.startswith(gl_watch.HOST): return load_gitlab(repo, sep, num)
    meta = api_json(f'repos/{repo}/issues/{num}')
    if meta is None: return load_discussion(repo, num)  # a discussion shares its repo's numbers, but REST has no issue for it
    if not isinstance(meta, dict) or 'number' not in meta: raise Unreadable(f'gh read no issue or PR at {repo}#{num}')
    f = os.path.join(CACHE, f"{repo.replace('/', '__')}__{num}.json")
    try:
        cached = json.load(open(f))
        if cached.get('updated_at') == meta.get('updated_at'): return cached
    except (OSError, ValueError): pass
    is_pr = 'pull_request' in meta
    items = [record('body', meta)]
    items += [record('comment', c) for c in fetch(f'repos/{repo}/issues/{num}/comments?per_page=100', True)]
    if is_pr:
        for r in fetch(f'repos/{repo}/pulls/{num}/reviews?per_page=100', True):
            if (r.get('body') or '').strip(): items.append(record('review', r, 'submitted_at', r.get('state') or ''))
        for c in fetch(f'repos/{repo}/pulls/{num}/comments?per_page=100', True):
            items.append(record('review comment', c, 'created_at', f"{c.get('path') or ''}:{c.get('line') or c.get('original_line') or ''}"))
    for e in fetch(f'repos/{repo}/issues/{num}/timeline?per_page=100', True):  # who set the title is a decision too
        if e.get('event') == 'renamed':
            r = e.get('rename') or {}
            items.append(record('rename', {'id': e.get('id'), 'user': e.get('actor'), 'created_at': e.get('created_at'), 'html_url': meta.get('html_url'),
                                           'body': f'Retitled "{r.get("from")}" to "{r.get("to")}".'}))
    items.sort(key=lambda x: (x['at'], x['id']))
    t = {'ref': f'{repo}#{num}', 'title': meta.get('title') or '', 'url': meta.get('html_url') or '', 'state': meta.get('state') or '',
         'is_pr': is_pr, 'updated_at': meta.get('updated_at'), 'items': items}
    try:
        os.makedirs(CACHE, exist_ok=True); json.dump(t, open(f, 'w'))
    except OSError: pass
    return t

def load_gitlab(repo, sep, num):
    """load() for a GitLab issue (sep '#') or merge request ('!'): its description and its notes, a diff note as a review comment."""
    kind, glab = 'merge_requests' if sep == '!' else 'issues', ('glab', 'api', '--hostname', 'gitlab.com')
    base = f"projects/{urllib.parse.quote(repo[len(gl_watch.HOST):], safe='')}/{kind}/{num}"
    meta = fetch(base, cmd=glab)
    if not isinstance(meta, dict) or 'iid' not in meta: raise Unreadable(f'glab read no {kind[:-1].replace("_", " ")} at {repo}{sep}{num}')
    f = os.path.join(CACHE, f"{repo.replace('/', '__')}__{sep}{num}.json")
    try:
        cached = json.load(open(f))
        if cached.get('updated_at') == meta.get('updated_at'): return cached
    except (OSError, ValueError): pass
    user = lambda a: {'login': (a or {}).get('username'), 'type': 'Bot' if gl_watch.BOT.search((a or {}).get('username') or '') else 'User'}
    items = [record('body', {'id': meta.get('id'), 'user': user(meta.get('author')), 'created_at': meta.get('created_at'), 'html_url': meta.get('web_url'), 'body': meta.get('description')})]
    for n in fetch(f'{base}/notes?sort=asc&order_by=created_at&per_page=100', True, glab):
        if n.get('system'): continue
        c = {'id': n.get('id'), 'user': user(n.get('author')), 'created_at': n.get('created_at'), 'html_url': f"{meta.get('web_url')}#note_{n.get('id')}", 'body': n.get('body')}
        p = n.get('position') or {}
        items.append(record('review comment', c, extra=f"{p.get('new_path') or p.get('old_path') or ''}:{p.get('new_line') or p.get('old_line') or ''}") if n.get('type') == 'DiffNote' else record('comment', c))
    items.sort(key=lambda x: (x['at'], x['id']))
    t = {'ref': f'{repo}{sep}{num}', 'title': meta.get('title') or '', 'url': meta.get('web_url') or '', 'state': meta.get('state') or '',
         'is_pr': kind == 'merge_requests', 'updated_at': meta.get('updated_at'), 'items': items}
    try:
        os.makedirs(CACHE, exist_ok=True); json.dump(t, open(f, 'w'))
    except OSError: pass
    return t

POST = 'databaseId createdAt url body author { login __typename }'
REPLIES = f'replies(first: 100, after: $endCursor) {{ pageInfo {{ hasNextPage endCursor }} nodes {{ {POST} }} }}'
DISCUSSION = f"""query($o: String!, $n: String!, $num: Int!, $endCursor: String) {{ repository(owner: $o, name: $n) {{ discussion(number: $num) {{
  {POST} title closed updatedAt
  comments(first: 100, after: $endCursor) {{ pageInfo {{ hasNextPage endCursor }} nodes {{ id {POST} replies(first: 100) {{ pageInfo {{ hasNextPage }} nodes {{ {POST} }} }} }} }} }} }} }}"""
COMMENT_REPLIES = f'query($id: ID!, $endCursor: String) {{ node(id: $id) {{ ... on DiscussionComment {{ {REPLIES} }} }} }}'

def load_discussion(repo, num):
    """load() for a GitHub Discussion, read over GraphQL: its body, every comment and every reply, page by page; not cached, as
    reading whether it changed would cost the same request."""
    o, n = repo.split('/')
    pages = api_json('graphql', True, args=('-f', f'query={DISCUSSION}', '-f', f'o={o}', '-f', f'n={n}', '-F', f'num={num}')) or []
    found = [(p.get('data') or {}).get('repository') or {} for p in pages if isinstance(p, dict)]
    d = (found[:1] or [{}])[0].get('discussion')
    if not d: raise Unreadable(f'gh read no issue, PR or discussion at {repo}#{num}')
    c = lambda x: {'id': x.get('databaseId'), 'user': {'login': (x.get('author') or {}).get('login'), 'type': (x.get('author') or {}).get('__typename')},
                   'created_at': x.get('createdAt'), 'html_url': x.get('url'), 'body': x.get('body')}
    items = [record('body', c(d))]
    for x in (x for p in found for x in ((p.get('discussion') or {}).get('comments') or {}).get('nodes') or []):
        items.append(record('comment', c(x)))
        replies = x.get('replies') or {}
        if (replies.get('pageInfo') or {}).get('hasNextPage'):  # over a page: all of them, read again from the first
            more = fetch('graphql', True, args=('-f', f'query={COMMENT_REPLIES}', '-f', f'id={x.get("id")}'))
            replies = {'nodes': [r for p in more for r in ((((p.get('data') or {}).get('node') or {}).get('replies') or {}).get('nodes') or [])]}
        items += [record('reply', c(r), extra=x.get('url') or '') for r in replies.get('nodes') or []]
    items.sort(key=lambda x: (x['at'], x['id']))
    return {'ref': f'{repo}#{num}', 'title': d.get('title') or '', 'url': d.get('url') or '', 'state': 'closed' if d.get('closed') else 'open',
            'is_pr': False, 'updated_at': d.get('updatedAt'), 'items': items}

def org_discussion(s):
    """(repo, '#', N) of an organization's discussion URL (github.com/orgs/<org>/discussions/N), from the repo GitHub keeps it in; None for
    another reference, or one gh finds no discussion at."""
    m = re.fullmatch(r'(?:https?://)?github\.com/orgs/([\w.-]+)/discussions/(\d+)(?:[/#?].*)?', s.strip())
    if not m: return None
    url = f'https://github.com/orgs/{m[1]}/discussions/{m[2]}'
    q = 'query($q: String!) { search(type: DISCUSSION, query: $q, first: 20) { nodes { ... on Discussion { number url repository { nameWithOwner } } } } }'
    found = api_json('graphql', args=('-f', f'query={q}', '-f', f'q=org:{m[1]} {m[2]}')) or {}
    hit = next((x for x in ((found.get('data') or {}).get('search') or {}).get('nodes') or [] if x.get('url') == url), None)
    return (hit['repository']['nameWithOwner'], '#', int(m[2])) if hit else None

def thread_ref(s):
    """parse_ref, and an organization's discussion URL; exits 2 on anything else, 1 on an organization's URL gh finds no discussion at."""
    rf = parse_ref(s) or org_discussion(s)
    if rf: return rf
    if re.search(r'github\.com/orgs/', s): die(f'thread-context: gh found no discussion at {s}: pass it as <owner/repo>#N, the repo its discussions are in')
    die(USAGE, 2)

def latest_human(t):
    """(at, id, url) of the newest comment by a human who isn't the agent (the root body doesn't count), else None."""
    hs = [x for x in t['items'] if x['kind'] not in ('body', 'rename') and not x['bot'] and not x['agent']]
    return max(((x['at'], x['id'], x['url']) for x in hs), default=None)

def refs(text, repo):
    """Thread refs (owner/repo#N, gitlab.com/<path>#N or !N) in text, in order; code blocks and quoted lines aren't followed.
    In a GitLab thread, <path>#N, <path>!N, #N and !N name GitLab threads."""
    text = uncoded(text)
    out, gl = [], repo.startswith(gl_watch.HOST)
    for m in re.finditer(r'https?://github\.com/((?!orgs/)[\w.-]+/[\w.-]+)/(?:issues|pull|discussions)/(\d+)', text): out.append(f'{m[1]}#{m[2]}')
    for m in re.finditer(r'https?://github\.com/orgs/[\w.-]+/discussions/\d+', text):
        if rf := org_discussion(m[0]): out.append(f'{rf[0]}#{rf[2]}')
    for m in re.finditer(r'https?://gitlab\.com/([\w.-]+(?:/[\w.-]+)+)/-/(issues|merge_requests)/(\d+)', text):
        out.append(f"{gl_watch.HOST}{m[1]}{'!' if m[2] == 'merge_requests' else '#'}{m[3]}")
    text = re.sub(r'https?://\S+', ' ', text)
    qualified = r'(?<![\w/.#!-])gitlab\.com/([\w.-]+(?:/[\w.-]+)+)([#!])(\d+)\b'  # in any thread, and before a GitLab thread's relative <path>#N
    for m in re.finditer(qualified, text): out.append(f'{gl_watch.HOST}{m[1]}{m[2]}{m[3]}')
    text = re.sub(qualified, ' ', text)
    named = r'(?<![\w/.#!-])([\w.-]+(?:/[\w.-]+)+)([#!])(\d+)\b' if gl else r'(?<![\w/.#-])([\w.-]+/[\w.-]+)(#)(\d+)\b'
    for m in re.finditer(named, text): out.append(f"{gl_watch.HOST if gl else ''}{m[1]}{m[2]}{m[3]}")
    text = re.sub(named, ' ', text)
    for m in re.finditer(r'(?<![\w/&#!])([#!])(\d{1,6})\b' if gl else r'(?<![\w/&#])(#)(\d{1,6})\b', text): out.append(f'{repo}{m[1]}{m[2]}')
    return out

def parse_ref(s):
    """(repo, '#' or '!', N) of a thread reference: owner/repo#N or its github.com issue, PR or discussion URL, gitlab.com/<path>#N (an issue) or !N (an MR)
    or its gitlab.com URL; None for anything else."""
    s = s.strip()
    m = re.fullmatch(r'(?:https?://)?(gitlab\.com/[\w.-]+(?:/[\w.-]+)+?)(?:([#!])|/-/(issues|merge_requests)/)(\d+)(?:[/#?].*)?', s)
    if m: return (m[1], m[2] or ('!' if m[3] == 'merge_requests' else '#'), int(m[4]))
    m = re.fullmatch(r'(?:https?://github\.com/(?!orgs/))?([\w.-]+/[\w.-]+?)(?:#|/(?:issues|pull|discussions)/)(\d+)(?:[/#?].*)?', s)
    return (m[1], '#', int(m[2])) if m else None

def tool(ref):
    return 'glab' if ref.startswith(gl_watch.HOST) else 'gh'

def tryload(ref):
    """load() of a reference, or the Unreadable it raised."""
    try: return load(*parse_ref(ref))
    except Unreadable as e: return e

def crawl(root, depth, cap):
    """Breadth-first: [(thread, depth, linked_from)] and the refs left out by the cap."""
    seen, order, level, left = {root}, [], [(root, None)], []
    for d in range(depth + 1):
        with ThreadPoolExecutor(8) as ex:
            loaded = list(ex.map(lambda rf: tryload(rf[0]), level))
        nxt = []
        for (ref, via), t in zip(level, loaded):
            if isinstance(t, Unreadable):
                if d == 0: die(f'thread-context: cannot read {ref}: {t}')
                continue
            if len(order) >= cap: left.append(ref); continue
            order.append((t, d, via))
            for x in t['items']:
                if x['bot']: continue
                for r in refs(x['body'], parse_ref(ref)[0]):
                    if r not in seen: seen.add(r); nxt.append((r, ref))
        level = nxt
        if not level: break
    return order, left

# ---- the ledger: one line per human comment with agreement, rejection, proposal or decision language
LANG = [
    ('agree', r"\b(agree[ds]?|sounds good|looks good|lgtm|sgtm|makes sense|go ahead|go for it|that works|fine by me|i'?m (?:ok|fine|happy) with|good idea|love it|ship it|approved?|exactly|yes,? (?:please|let'?s|do)|\+1)\b|👍"),
    ('reject', r"\b(disagree[ds]?|nope|i don'?t think|not (?:a fan|convinced|sure)|i'?d rather|rather not|prefer\w*|bad idea|against|reject\w*|don'?t want|won'?t work|shouldn'?t|no,|instead of|-1)\b|👎"),
    ('propose', r"\b(propos\w*|suggest\w*|what if|how about|we could|we should|i think we should|let'?s|idea:|option [a-z0-9]\b|alternative\w*|maybe we|plan is)\b"),
    ('decide', r"\b(decid\w*|decision|we'?ll go with|going with|settled|conclusion|from now on|the rule|convention|policy|will merge|we (?:will|won'?t))\b"),
]
def ledger_line(x):
    if x['kind'] == 'rename': return ['title'], x['body']
    text = uncoded(x['body'])
    text = '\n'.join(l for l in text.split('\n') if not l.lstrip().startswith('>'))
    text = re.sub(r'<[^>]+>|\[([^\]]*)\]\([^)]*\)', lambda m: m[1] or '', text)
    sents = [s.strip() for s in re.split(r'(?<=[.!?])\s+|\n+', text) if s.strip()]
    def tags_of(sent):
        return [tag for tag, rx in LANG if re.search(rx, sent, re.I) and (tag == 'propose' or not sent.endswith('?'))]  # a question doesn't agree, reject or decide
    cand = [(s, tags_of(s)) for s in sents]
    cand = [(s, t) for s, t in cand if t]
    if not cand: return None
    quote, tags = next(((s, t) for s, t in cand if t != ['propose']), cand[0])  # a stated position beats a bare proposal
    quote = re.sub(r'\s+', ' ', quote)
    return tags, (quote[:197] + '...') if len(quote) > 200 else quote

def day(at): return at[:10]

def render(order, left, root, depth, cap):
    rt = order[0][0]
    lh = latest_human(rt)
    L = [f'# Thread context: {root}', '',
         'Drafting input for replies on this thread. Read the ledger and the root transcript in full before drafting; check every claim about who said, proposed or agreed what against them, and link it (the permalinks below). The agent\'s own earlier posts are in the transcript marked `AGENT` and are not positions of anyone else.', '',
         f'- root: {root} {rt["url"]}',
         f'- latest-human-comment: id={lh[1] if lh else 0} at={lh[0] if lh else 0} {lh[2] if lh else ""}'.rstrip(),
         f'- generated: {datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")}  (depth {depth}, max {cap} threads)',
         f'- threads included ({len(order)}):']
    for t, d, via in order:
        n = sum(1 for x in t['items'] if x['kind'] != 'body' and not x['bot']); nb = sum(1 for x in t['items'] if x['bot'])
        L.append(f'  - {t["ref"]} "{t["title"]}" ({"PR" if t["is_pr"] else "discussion" if "/discussions/" in t["url"] else "issue"}, {t["state"]}, {n} comments' + (f', {nb} bot comments omitted' if nb else '') +
                 (', root' if via is None else f', depth {d}, linked from {via}') + ')')
    if left: L.append(f'- referenced but not fetched (over the cap of {cap}): ' + ', '.join(left))
    L += ['', '## Decisions and positions', '',
          'One line per human comment (not the agent\'s) with agreement, rejection, proposal or decision language: `date @author [tags] "quote" permalink`. A line is a pointer: open the permalink in the transcript before attributing anything.', '']
    n = 0
    for t, d, via in order:
        lines = [(x, ledger_line(x)) for x in t['items'] if not x['bot'] and not x['agent']]
        lines = [(x, l) for x, l in lines if l]
        if not lines: continue
        L.append(f'### {t["ref"]}' + (' (root)' if via is None else ''))
        for x, (tags, q) in lines:
            n += 1
            L.append(f'- {day(x["at"])} @{x["author"]} [{"/".join(tags)}] "{q}" {x["url"]}')
        L.append('')
    if not n: L.append('(none found)\n')
    def transcript(t, last=None):
        its = [x for x in t['items'] if not x['bot']]
        out = [f'## {"Root transcript: " if last is None else ""}{t["ref"]} "{t["title"]}"', '', f'{t["url"]} ({t["state"]})', '']
        if last is not None and len(its) > last + 1:
            out += [f'(first post kept; {len(its) - last - 1} earlier comments omitted)', '']
            its = its[:1] + its[-last:]
        for x in its:
            body = x['body'].strip()
            if last is not None and len(body) > LINKED_BODY: body = body[:LINKED_BODY] + f'\n... (cut at {LINKED_BODY} characters, full text at the permalink)'
            who = f'@{x["author"]}' + (' AGENT (badge: the agent\'s own post)' if x['agent'] else '')
            what = {'body': 'opened', 'comment': 'comment', 'review': f'review {x["extra"]}'.strip(), 'review comment': f'review comment {x["extra"]}'.strip(), 'reply': f'reply to {x["extra"]}', 'rename': 'retitled'}[x['kind']]
            out += [f'### {x["at"]} {who}, {what}', x['url'], '', re.sub(r'^#', r'\\#', body, flags=re.M) or '(empty)', '']
        return out
    L += transcript(rt)
    if len(order) > 1:
        L += ['# Linked threads', '']
        for t, d, via in order[1:]:
            L += transcript(t, LINKED_LAST)
    return '\n'.join(L).rstrip() + '\n'

def header(path):
    s = open(path).read(20000)
    r = re.search(r'^- root: (\S+)', s, re.M); l = re.search(r'^- latest-human-comment: id=(\d+) at=(\S+)', s, re.M)
    return (r[1] if r else None), ((l[2], int(l[1])) if l else None)

def verify(path, target, parent):
    """Reason string if path doesn't satisfy the gate, else ''."""
    cmd = f'thread-context {target or "<owner/repo#N>"} --out {path}'
    if not os.path.isfile(path): return f'no thread-context.md at {path}: run `{cmd}`, read its decisions ledger and root transcript, then draft (or re-draft) from it'
    root, rec = header(path)
    if not root or not rec: return f'{path} is not a thread-context file: run `{cmd}`'
    if target and root != target: return f'{path} is the context of {root}, not {target}: keep one drafts folder per thread, or run `{cmd}`'
    # a parent saved after the record is fine while the record still holds the thread's latest human comment
    target = target or (root if parent and os.path.exists(parent) and os.path.getmtime(path) < os.path.getmtime(parent) else None)
    if target:
        t = tryload(target) if parse_ref(target) else Unreadable('not a thread reference')
        if isinstance(t, Unreadable): return f"{tool(target)} couldn't read {target} ({t}), so whether {path} records its latest comment can't be checked: retry once {tool(target)} answers"
        lh = latest_human(t)
        if lh and (lh[0], lh[1]) > rec:
            return f'{path} records the latest comment of {target} as {rec[0]} (id {rec[1]}), but the thread has {lh[2]} ({lh[0]}): run `{cmd}`, read what is new, and re-draft'
    return ''

def main(argv):
    if not argv or argv[0] in ('-h', '--help'): die(__doc__ if argv else USAGE, 0 if argv else 2)
    def opt(name, default=None):
        if name not in argv: return default
        i = argv.index(name)
        if i + 1 >= len(argv): die(USAGE, 2)
        return argv[i + 1]
    if argv[0] in ('--latest', '--ref', '--items'):
        rf = thread_ref(opt(argv[0]) or '')
        if argv[0] == '--ref': print(f'{rf[0]}{rf[1]}{rf[2]}'); return
        t = tryload(f'{rf[0]}{rf[1]}{rf[2]}')
        if isinstance(t, Unreadable): die(f'thread-context: cannot read {opt(argv[0])}: {t}')
        if argv[0] == '--items': print(json.dumps(t['items'])); return
        lh = latest_human(t)
        print(f'{lh[1]} {lh[0]}' if lh else '0 0'); return
    if argv[0] == '--verify':
        why = verify(opt('--verify'), opt('--target'), opt('--parent'))
        if why: die(why)
        return
    rf = thread_ref(argv[0])
    depth, cap, out = int(opt('--depth', 2)), int(opt('--max', 30)), opt('--out', os.path.join(os.getcwd(), 'thread-context.md'))
    root = f'{rf[0]}{rf[1]}{rf[2]}'
    order, left = crawl(root, depth, cap)
    text = render(order, left, root, depth, cap)
    os.makedirs(os.path.dirname(os.path.abspath(out)), exist_ok=True)
    open(out, 'w').write(text)
    print(f'thread-context: {out}: {len(order)} threads, {len(text)} characters')

main(sys.argv[1:])
