#!/bin/bash
# netns-run <command...>: runs the command in a private network namespace: its own ports (a server on :3000 inside
# doesn't touch the host's :3000) and internet access through slirp4netns. Exits with the command's status.
set -u
command -v slirp4netns >/dev/null || { echo "netns-run: slirp4netns is not installed (sudo apt install slirp4netns)" >&2; exit 127; }
# netns-run itself runs only these two, setpriv, slirp4netns and a final rm; these two hold only the substitution's pipe
dir=$(exec 2>&1; d=$(mktemp -d) && mkfifo "$d/ns" "$d/go" "$d/ready" "$d/exit" && echo "$d")
[ -d "$dir" ] || { echo "netns-run: $dir" >&2; exit 1; }
# DNS goes to slirp4netns's forwarder: the host's resolv.conf may name a stub (systemd-resolved's 127.0.0.53) that only
# the host's own loopback answers. Its search, domain and options lines stay, so short names resolve as on the host.
{ echo 'nameserver 10.0.2.3'; while IFS= read -r l; do [[ $l =~ ^(search|domain|options)[[:space:]] ]] && echo "$l"; done 2>/dev/null </etc/resolv.conf; } > "$dir/resolv.conf"
# The namespace's first process reports its pid, waits until slirp4netns has configured tap0, then runs the command as
# the caller's own uid and gid (unshare -r makes it root, whose home is /root)
# It runs on only after reading "go" from go_in, whose only write end netns-run holds: it reads EOF if netns-run ends first
uid=$EUID; while read -r k _ gid _; do [ "$k" = Gid: ] && break; done </proc/self/status  # Gid: real effective saved fs
exec {report}<>"$dir/ns" {go}<>"$dir/go" {go_in}<"$dir/go" {alive}<>"$dir/exit"
# From then on the death signals tie it to netns-run: netns-run's end kills unshare, whose end sends the namespace TERM
setpriv --pdeathsig KILL unshare -rnm --fork --kill-child=TERM bash -c 'r=$1 i=$2; echo $$ >&"$r"; exec {r}>&-; read -r go <&"$i"; exec {i}<&-; [ "$go" = go ] || exit 1; setpriv --pdeathsig KILL ip link set lo up; if [ -e /etc/resolv.conf ]; then setpriv --pdeathsig KILL mount --bind "$3" /etc/resolv.conf || exit 1; fi; u=$4 g=$5; shift 5; exec unshare -U --map-user="$u" --map-group="$g" "$@"' _ "$report" "$go_in" "$dir/resolv.conf" "$uid" "$gid" "$@" {go}>&- {alive}>&- &
ushare=$!
exec {go_in}<&-
# Closing go and alive ends the namespace and slirp4netns; netns-run ending closes them too
fail() { echo "netns-run: $1" >&2; exec {go}>&- {alive}>&-; wait; rm -rf "$dir"; exit 1; }
read -r -t 5 ns <&"$report" || fail "the namespace didn't start"
exec {report}<&- {ready}<>"$dir/ready" {alive_in}<"$dir/exit"
# slirp4netns writes 1 to ready once tap0 is up; the newline after it exits ends the wait as soon as it fails
{ slirp4netns --configure --mtu=65520 --disable-host-loopback --ready-fd="$ready" --exit-fd="$alive_in" "$ns" tap0 >/dev/null 2>"$dir/slirp.log"; echo >&"$ready"; } {go}>&- {alive}>&- &
exec {alive_in}<&-
read -r -n 1 -t 10 up <&"$ready" && [ "$up" = 1 ] || { read -r -d '' log <"$dir/slirp.log"; fail "slirp4netns didn't come up: $log"; }
echo go >&"$go"
wait "$ushare"; status=$?
exec {alive}>&-; wait
rm -rf "$dir"
exit $status
