#!/usr/bin/env python3
"""disk-sweep [--delete]: with --delete, deletes the build folders and node_modules under the work folders (~/.mergeworthy/work/*/
and ~/*-work/) and ~/.t3/worktrees/ that hold nothing a rebuild can't restore, each finished work folder (w-done), and prunes Docker's dangling images and build cache. Before each
deletion it appends `<UTC time, YYYY-MM-DDTHH:MM:SSZ> <bytes> <path, or docker:image or docker:builder> <rule> deleting` to
~/.mergeworthy/disk-sweep.log, and the same line ending `deleted` or `failed` after it. <bytes> is the allocated size of the
entries whose every hard link is inside the path; a Docker prune writes one line, `deleted`, with the size Docker reports once it
succeeded. Without --delete it prints those lines without the last word, `?` for Docker's bytes, and deletes nothing.
It never follows a symlink or leaves a root's filesystem, deletes nothing with a symlink on its path, and runs one at a time.
"Idle": no file outside the paths git ignores has an mtime within 24 hours of the sweep's start. "Busy": a process works in the
folder or holds a file open in it, or an unfinished job in ~/.claude/agent-jobs names its absolute or ~/ path, read each time.
A candidate is kept when it holds version-control data (not for w-done), a file with an mtime in
the last 24 hours or a folder the sweep can't read, or when its repo or loose parent is busy right before it would be listed or
deleted.
- c-ignored: in an idle repo or worktree that isn't busy, the folders git ignores named in BUILD.
- c-node_modules: outside any repo in a work folder, a node_modules whose parent is idle (node_modules and nested repos aside)
  and isn't busy.
- w-done, once a day: a folder directly under ~/.mergeworthy/work but the steward's, whole, once T3's database shows the thread its
  t3-thread names deleted (steward.thread_state), or, with no settled, archived or unanswered thread, once its watcher retired and it is
  untouched for 8 days, its watcher's own files aside, which a 24-hour change doesn't count either; a watcher still running in it keeps
  it (busy); a repo in it with a worktree outside keeps it; then `git worktree prune` in each repo outside it that had a worktree in it;
  ~/.mergeworthy/work-kept.md lists each finished folder that stays, and why.
- w-merged, once a day: each worktree in the steward's folder whose branch is merged (into origin/main with a commit of its own, or
  squash-merged: gone from origin, GitHub showing a merged PR headed at its tip), with no uncommitted change, untouched for 8 days
  with its <name>-notes/ folder; both go, then its branch.
- h-ignored, once a day: the same folders in any git repo up to 5 levels below HOME (hidden folders and the work folders
  aside), each unused for 14 days (neither written nor read).
- h-cargo, once a day: a cargo build folder (CACHEDIR.TAG beside .rustc_info.json) up to 5 levels below HOME, in a git repo or not
  (hidden folders and the work folders aside), whole, unused for 7 days (neither written nor read), unless its parent is
  busy or h-ignored takes it.
- k-cache, once a day: `pnpm store prune`, `pip cache purge`, `npm cache clean --force` when ~/.npm/_cacache is unused for
  14 days, and each entry of the named tool caches (CACHES: cargo's, and ~/.cache/yarn, node-gyp, go-build and the like) unused for 14 days (neither written nor read), not busy.
- d-docker: `docker image prune -a` (every unused image) and `docker builder prune`, with `-f --filter until=336h`, each by its
  own age rule, then `docker builder prune` down to a tenth of the filesystem holding Docker's root dir; never containers or volumes.
Weekly, ~/.mergeworthy/disk-report.md lists the 20 largest folders under HOME unused for 14 days (neither written nor read) that no rule deletes.
Deleting under the account's home and pruning Docker happen only when the watcher daemon of the main watch dir started the sweep
(from_daemon); anything else deletes only in folders outside that home, a test's temp roots."""
import datetime, fcntl, glob, json, os, pwd, re, shutil, subprocess, sys, time
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), '..', 'hooks'))
import agent_jobs, steward, work_folder

if not os.path.isdir('/proc/self'):
    sys.exit('disk-sweep: needs /proc to see which processes work where')
DRY = True
HOME, NOW = os.path.expanduser('~'), time.time()
DAY = 86400
OLD = 14 * DAY  # the round-7 rules: unused for 14 days (neither written nor read)
WEEK = 7 * DAY  # h-cargo's: a Rust build grows by gigabytes a day
CARGO = ('CACHEDIR.TAG', '.rustc_info.json')  # both in a cargo target dir; the tag alone also marks pytest, ruff and uv caches
VCS = {'.git', '.hg', '.svn', '.jj'}  # a checkout's commits and edits, which no build restores
BUILD = {'node_modules', 'dist', 'build', '.next', '.vite', '.turbo', '.svelte-kit', 'coverage', 'test-results', 'playwright-report', 'target', '.pnpm-store', '.venv', '.mypy_cache'}  # never .cache: projects keep dumps and reports there
IDLE = 8 * DAY  # w-done's fallback: a folder its retired watcher left untouched this long
WATCHER = {'events.log', 'retired', 'disk-sweep.out', 'threads.txt', 'repos.txt'}  # with gh-watch* and t3-*: the files a watcher writes in its dir
STATE = os.path.join(HOME, '.mergeworthy')
ACCOUNT_HOME = os.path.realpath(pwd.getpwuid(os.getuid()).pw_dir)  # from the password database: a probe's HOME can't move it
INSTALLED = os.path.realpath(os.path.join(ACCOUNT_HOME, '.mergeworthy', 'current'))


def inside(path, top):
    return path == top or path.startswith(top + '/')


def main_watch_dir():
    """The account's main watch dir, as the watcher's main_dir() picks it: ~/.mergeworthy/main-watch while its watcher runs,
    else the first live dir in ~/.claude/gh-watch-dirs.txt."""
    def live(d):
        try:
            os.kill(int(open(os.path.join(d, 'gh-watch.pid')).read().strip()), 0)
            return True
        except (OSError, ValueError):
            return False
    try:
        dirs = [open(os.path.join(ACCOUNT_HOME, '.mergeworthy', 'main-watch')).read().strip()]
    except OSError:
        dirs = []
    try:
        dirs += [l.strip() for l in open(os.path.join(ACCOUNT_HOME, '.claude', 'gh-watch-dirs.txt'))]
    except OSError:
        pass
    return next((os.path.realpath(d) for d in dirs if d and live(d)), None)


def from_daemon(installed, main):
    """Whether the watcher daemon of the watch dir main, running from installed, started this process: this file is inside
    installed, its parent runs installed's gh-watch.py with main as its working dir, and main's gh-watch.pid names the
    parent's parent, the daemon's loop. A test, a probe or an imported main() has another parent, another copy or no pid file."""
    if not main or not inside(os.path.realpath(__file__), installed):
        return False
    ppid = os.getppid()
    try:
        here = os.readlink(f'/proc/{ppid}/cwd')
        argv = open(f'/proc/{ppid}/cmdline', 'rb').read().decode(errors='replace').split('\0')
        loop = int(open(f'/proc/{ppid}/stat').read().rsplit(')', 1)[1].split()[1])
        pid = int(open(os.path.join(here, 'gh-watch.pid')).read().strip())
    except (OSError, ValueError, IndexError):
        return False
    script = next((a for a in argv if os.path.basename(a) == 'gh-watch.py'), None)
    return bool(script) and inside(os.path.realpath(os.path.join(here, script)), installed) and here == main and pid == loop


def record(nbytes, what, rule, state):
    line = f"{datetime.datetime.now(datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')} {nbytes} {what} {rule}"
    if DRY:
        print(line, flush=True)
    else:
        with open(os.path.join(STATE, 'disk-sweep.log'), 'a') as f:
            f.write(f'{line} {state}\n')


def git(repo, *args):
    return subprocess.run(['git', '--no-optional-locks', '-C', repo, *args], capture_output=True, text=True)


def mention(path):
    """A regex for path, or a path inside it, as a job's text writes it: absolute or from ~/."""
    forms = [path] + (['~' + path[len(HOME):]] if path.startswith(HOME + '/') else [])
    return '(?:' + '|'.join(map(re.escape, forms)) + r')(?![\w-]|\.[\w.-])'  # a sentence's full stop may follow it


def measure(path, dev, age=DAY, vcs=True, skip=None):
    """The bytes deleting path frees (st_blocks * 512 of each entry whose every hard link is inside), or None when it must stay: it holds an
    entry on another filesystem, version-control data (VCS), a file changed in the last 24 hours outside the paths skip(path relative to
    path) excludes, or a folder it can't read."""
    st = os.lstat(path)
    if st.st_dev != dev:
        return None
    inodes, stack = {st.st_ino: [1 if os.path.isdir(path) else st.st_nlink, 1, st.st_blocks * 512]}, [path]
    while stack:
        try:
            entries = list(os.scandir(stack.pop()))
        except OSError:
            return None
        for e in entries:
            st = e.stat(follow_symlinks=False)
            d = e.is_dir(follow_symlinks=False)
            if st.st_dev != dev or vcs and e.name in VCS or not d and used(st, age) and not (skip and skip(os.path.relpath(e.path, path))):
                return None
            inodes.setdefault(st.st_ino, [1 if d else st.st_nlink, 0, st.st_blocks * 512])[1] += 1
            if d:
                stack.append(e.path)
    return sum(blocks for links, seen, blocks in inodes.values() if seen >= links)


def used(st, age):
    """Whether a file was written within age of the start, or, for the rules longer than a day, also read (relatime updates atime about once a day):
    a browser build or a tool's binary is only read once installed."""
    return max(st.st_mtime, st.st_atime) > NOW - age if age > DAY else st.st_mtime > NOW - age


def changed(top, skip, age=DAY):
    """Whether a file under top, outside the paths skip(path relative to top) excludes, was used within age of the start (used())."""
    stack = [top]
    while stack:
        try:
            entries = list(os.scandir(stack.pop()))
        except OSError:
            continue
        for e in entries:
            if skip(os.path.relpath(e.path, top)):
                continue
            if e.is_dir(follow_symlinks=False):
                stack.append(e.path)
            elif used(e.stat(follow_symlinks=False), age):
                return True
    return False


def in_use(path):
    """A process has its cwd or an open file inside path, read from /proc now (the kernel's link targets hold no symlinks)."""
    for pid in filter(str.isdigit, os.listdir('/proc')):
        if int(pid) == os.getpid():
            continue
        links = [f'/proc/{pid}/cwd']
        try:
            links += [f'/proc/{pid}/fd/{fd}' for fd in os.listdir(f'/proc/{pid}/fd')]
        except OSError:
            pass
        for link in links:
            try:
                target = os.readlink(link)
            except OSError:
                continue
            if (target + '/').startswith(path + '/'):
                return True
    return False


_daemon = {}


def authorized(path=None):
    """Raise PermissionError unless this process may delete path now, or run a Docker command (path None): never in a dry run,
    and under the account's home or for Docker only when the main watch dir's daemon started it (from_daemon, worked out once
    per parent process). Every function that deletes or runs Docker calls it right before the syscall or the exec."""
    if DRY:
        raise PermissionError('disk-sweep: a dry run deletes nothing and runs no Docker command')
    if path is None or inside(path, ACCOUNT_HOME):
        if os.getppid() not in _daemon:
            _daemon[os.getppid()] = from_daemon(INSTALLED, main_watch_dir())
        if not _daemon[os.getppid()]:
            raise PermissionError(f'disk-sweep: only the watcher daemon of the main watch dir deletes under {ACCOUNT_HOME} or runs Docker')


def open_dir(path):
    """An fd of the directory path, opened from / one component at a time; OSError when a component is a symlink."""
    fd = os.open('/', os.O_RDONLY | os.O_DIRECTORY)
    for name in path.strip('/').split('/'):
        try:
            sub = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
        finally:
            os.close(fd)
        fd = sub
    return fd


def empty(fd, path=None):
    """Delete everything inside the open directory fd (path, for authorized), opening each subdirectory without following a symlink."""
    path = path or os.readlink(f'/proc/self/fd/{fd}')
    for e in os.scandir(fd):
        if e.is_dir(follow_symlinks=False):
            sub = os.open(e.name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
            try:
                empty(sub, os.path.join(path, e.name))
            finally:
                os.close(sub)
            authorized(os.path.join(path, e.name))
            os.rmdir(e.name, dir_fd=fd)
        else:
            authorized(os.path.join(path, e.name))
            os.unlink(e.name, dir_fd=fd)


def remove(path, st):
    """Delete the directory path through fds opened without following a symlink, only while it is still the inode st."""
    parent = open_dir(os.path.dirname(path))
    try:
        fd = os.open(os.path.basename(path), os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent)
        try:
            if (os.fstat(fd).st_dev, os.fstat(fd).st_ino) != (st.st_dev, st.st_ino):
                raise OSError(f'{path} is no longer the directory the sweep inspected')
            empty(fd, path)
        finally:
            os.close(fd)
        authorized(path)
        os.rmdir(os.path.basename(path), dir_fd=parent)
    finally:
        os.close(parent)


_jobs = [None, []]


def jobs_text():
    """The key, brief and ticket files of each unfinished agent job, read again whenever the job folder's listing changes."""
    try:
        listing = sorted((f, os.stat(os.path.join(agent_jobs.JOBS, f)).st_mtime_ns) for f in os.listdir(agent_jobs.JOBS))
    except OSError:
        listing = []
    if listing != _jobs[0]:
        _jobs[0], _jobs[1] = listing, []
        for _, j in agent_jobs.jobs():
            if not agent_jobs.finished(j):
                tickets = [p for p in j['key'].split() if p.startswith('/') and os.path.isfile(p)]
                _jobs[1].append('\n'.join([j['key'], j.get('brief', '')] + [open(t, errors='replace').read() for t in tickets]))
    return _jobs[1]


def busy(path):
    """A process works in path or holds a file open inside it, or an unfinished agent job names it or a path inside it."""
    rx = re.compile(mention(path))
    return in_use(path) or any(rx.search(t) for t in jobs_text())


def delete(path, owner, dev, rule, age=DAY, vcs=True, skip=None):
    """Delete path, a candidate inside owner (its repo, or a loose node_modules' parent), unless it or owner must stay; None when it
    did (a dry run: would), else why not."""
    st = os.lstat(path)
    if os.path.realpath(path) != path:
        return 'a symlink on its path'
    nbytes = measure(path, dev, age, vcs, skip)
    if nbytes is None:
        recent = 'a file changed in the last 24 hours' if age == DAY else f'a file used in the last {age // DAY} days'
        return f"{recent}, {'version-control data, ' if vcs else ''}a mount or an unreadable folder"
    if busy(owner):  # a process or a job may have started in owner since its selection
        return 'a process or agent job works in it'
    if not DRY:
        record(nbytes, path, rule, 'deleting')
        try:
            remove(path, st)
        except OSError as e:
            print(f'disk-sweep: {path}: {e}', file=sys.stderr)
            record(nbytes, path, rule, 'failed')
            return f'its deletion failed: {e} (disk-sweep.log)'
    record(nbytes, path, rule, 'deleted')


def walk(root, work):
    """(root's device, the repos under root, and when work is true the node_modules folders outside them), on root's filesystem."""
    dev, repos, loose, stack = os.lstat(root).st_dev, [], [], [root]
    while stack:
        d = stack.pop()
        if os.path.lexists(os.path.join(d, '.git')):
            repos.append(d)
            continue
        try:
            entries = list(os.scandir(d))
        except OSError:
            continue
        for e in entries:
            st = e.stat(follow_symlinks=False)
            if e.is_symlink() or st.st_dev != dev:
                continue
            if e.is_dir() and e.name != 'node_modules':
                stack.append(e.path)
            elif e.is_dir() and work:
                loose.append(e.path)
    return dev, repos, loose


def iso(t):
    return datetime.datetime.fromtimestamp(t, datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')


def newest(top, skip):
    """The newest mtime of a file under top outside the paths skip(path relative to top) excludes, else top's own."""
    latest, stack = 0, [top]
    while stack:
        try:
            entries = list(os.scandir(stack.pop()))
        except OSError:
            continue
        for e in entries:
            if skip(os.path.relpath(e.path, top)):
                continue
            if e.is_dir(follow_symlinks=False):
                stack.append(e.path)
            else:
                latest = max(latest, e.stat(follow_symlinks=False).st_mtime)
    return latest or os.lstat(top).st_mtime


def watcher_file(folder):
    """skip() of the files a watcher writes in its watch dir (folder, or a folder directly in it, holding gh-watch.pid): only files at
    that dir's top level, never a directory or anything in one, so a checkout named t3-* or gh-watch* counts like any other."""
    def skip(rel):
        name, where = os.path.basename(rel), os.path.dirname(rel)
        path = os.path.join(folder, rel)
        return ((name in WATCHER or name.startswith(('gh-watch', 't3-'))) and os.sep not in where
                and os.path.isfile(os.path.join(folder, where, 'gh-watch.pid')) and os.path.isfile(path) and not os.path.islink(path))
    return skip


def thread_state(folder):
    """steward.thread_state of the thread folder/t3-thread (else t3-gone) names, as the watcher's tick reads it: 'deleted', 'settled' or
    'live'; 'unknown' when T3's database can't be read; None without a thread."""
    tid = steward.thread_of(folder)
    return steward.thread_state(tid) or 'unknown' if tid else None


def sweep_work():
    """Once a day, w-done: each folder directly under work_folder.ROOT but the steward's whose T3 thread is deleted (thread_state), or whose
    watcher retired and that is untouched for IDLE outside its watcher's files (watcher_file) while no such thread is settled, archived or unanswered:
    once no such file changed in 24 hours and no repo in it lends a worktree outside it (work_folder.lent), it is deleted whole through
    delete(), which keeps it while a watcher still runs there (busy); ~/.mergeworthy/work-kept.md (a dry run: stdout) lists each finished
    folder that stays, and why."""
    root = work_folder.ROOT
    if not due('work', DAY) or os.path.islink(root) or not os.path.isdir(root):
        return
    dev, rows = os.lstat(root).st_dev, []
    for e in sorted(os.scandir(root), key=lambda e: e.name):
        if not e.is_dir(follow_symlinks=False) or steward.in_folder(e.path):
            continue
        skip, linked = watcher_file(e.path), []
        try:
            state = thread_state(e.path)
            if state == 'settled':
                rows.append(f'- {e.path}: its T3 thread is settled or archived; it goes once T3 deletes the thread')
                continue
            if state != 'deleted':
                if not os.path.isfile(os.path.join(e.path, 'retired')):
                    continue
                if state == 'unknown':  # it may be settled: kept until T3's database can be read
                    rows.append(f'- {e.path}: T3 gave no answer about its thread; kept this run')
                    continue
                if (at := newest(e.path, skip) + IDLE) > NOW:
                    rows.append(f'- {e.path}: its watcher retired; deleted no sooner than {iso(at)} if left untouched')
                    continue
            why = work_folder.lent(e.path) or (['a file changed in the last 24 hours'] if changed(e.path, skip) else [])
            linked = [] if why else work_folder.outside_repos(e.path)
        except Exception as err:  # this folder stays; the next ones and the other rules still run
            why = [f'check failed: {err}']
        if not why:
            if refused := delete(e.path, e.path, dev, 'w-done', vcs=False, skip=skip):
                why = [refused]
            elif not DRY:
                for c in linked:  # the deleted worktrees' entries there would keep holding their branches
                    authorized(c)
                    work_folder.git(c, 'worktree', 'prune')
        rows += [f'- {e.path}: {w}' for w in why]
    if DRY:
        for r in rows:
            print(r, flush=True)
        return
    with open(os.path.join(STATE, 'work-kept.md'), 'w') as f:
        f.write('# Finished work folders disk-sweep keeps, and why (rule w-done)\n\n' + ''.join(r + '\n' for r in rows))


def merged(tree):
    """Whether worktree tree's HEAD is merged: origin/HEAD (else origin/main) reaches it off its first-parent line (a HEAD on that line is
    a base commit the branch never added to), or its branch is gone from origin and GitHub shows a merged pull request headed at that
    commit (a squash merge); False on any answer missing, the watchers' shared pause too."""
    g = lambda *a: work_folder.git(tree, *a)
    head, branch = g('rev-parse', 'HEAD').stdout.strip(), g('symbolic-ref', '-q', '--short', 'HEAD').stdout.strip()
    base = next((r for r in ('origin/HEAD', 'origin/main') if not g('rev-parse', '-q', '--verify', r).returncode), None)
    if not head:
        return False
    if base and not g('merge-base', '--is-ancestor', head, base).returncode:
        return head not in g('rev-list', '--first-parent', base).stdout.split()
    url = g('config', 'remote.origin.url').stdout.strip()
    hub = work_folder.GITHUB.match(url)
    if not branch or not hub:
        return False
    try:
        if json.load(open(os.path.join(STATE, 'shared-watch.json'))).get('pause_until', 0) > time.time():
            return False
    except (OSError, ValueError):
        pass
    try:
        gone = subprocess.run(['git', '-C', '/', 'ls-remote', url, f'refs/heads/{branch}'], capture_output=True, text=True, stdin=subprocess.DEVNULL,
                              env={**os.environ, 'GIT_TERMINAL_PROMPT': '0'}, timeout=60)
        if gone.returncode or gone.stdout.strip():
            return False
        r = subprocess.run(['gh', 'api', f'repos/{hub[1]}/commits/{head}/pulls'], capture_output=True, text=True, timeout=60)
        return not r.returncode and any(p.get('merged_at') and p.get('head', {}).get('sha') == head for p in json.loads(r.stdout))
    except (OSError, subprocess.TimeoutExpired, ValueError, AttributeError):
        return False


def sweep_steward():
    """Once a day, w-merged: each linked worktree directly in the steward's folder whose HEAD is merged (merged()), with no uncommitted
    change, and that, with its <name>-notes/ beside it, is untouched for IDLE, deleted through delete(), then that notes folder; then
    `git worktree prune` and `git branch -D <its branch>` in its repo."""
    top = steward.folder()
    if not due('steward', DAY) or os.path.islink(top) or not os.path.isdir(top):
        return
    dev = os.lstat(top).st_dev
    for e in sorted(os.scandir(top), key=lambda e: e.name):
        notes = e.path + '-notes'
        if not e.is_dir(follow_symlinks=False) or not os.path.isfile(os.path.join(e.path, '.git')):
            continue
        if any(newest(p, lambda rel: False) > NOW - IDLE for p in (e.path, notes) if os.path.isdir(p) and not os.path.islink(p)) or not merged(e.path):
            continue
        status = work_folder.git(e.path, 'status', '--porcelain')
        if status.returncode or status.stdout.strip():  # an uncommitted change: git worktree remove itself refuses it
            continue
        common, branch = work_folder.common_dir(e.path), work_folder.git(e.path, 'symbolic-ref', '-q', '--short', 'HEAD').stdout.strip()
        if delete(e.path, e.path, dev, 'w-merged', vcs=False):
            continue
        if os.path.isdir(notes) and not os.path.islink(notes):
            delete(notes, notes, dev, 'w-merged', vcs=False)
        if not DRY and common:
            authorized(common)
            work_folder.git(common, 'worktree', 'prune')
            if branch:
                work_folder.git(common, 'branch', '-D', branch)


def sweep_files():
    roots = [(r.rstrip('/'), True) for r in sorted(glob.glob(os.path.join(HOME, '*-work/')) + glob.glob(os.path.join(work_folder.ROOT, '*/')))]
    roots.append((os.path.join(HOME, '.t3', 'worktrees'), False))
    for root, work in roots:
        if os.path.islink(root) or not os.path.isdir(root):
            continue
        dev, repos, loose = walk(root, work)
        for repo in repos:
            sweep_repo(repo, dev, 'c-ignored', DAY)
        for nm in loose:
            parent = os.path.dirname(nm)
            if not busy(parent) and not changed(parent, lambda rel: os.path.basename(rel) == 'node_modules' or os.path.lexists(os.path.join(parent, rel, '.git'))):
                delete(nm, parent, dev, 'c-node_modules')


def sweep_repo(repo, dev, rule, age):
    """In an idle repo that isn't busy, the folders git ignores named in BUILD, each unused for age (used()); the ones it deleted
    (a dry run: would)."""
    listed = git(repo, 'ls-files', '-z', '-o', '-i', '--exclude-standard', '--directory')
    ignored = {p.rstrip('/') for p in listed.stdout.split('\0') if p}
    taken = set()
    if listed.returncode or busy(repo) or changed(repo, lambda rel: rel == '.git' or rel in ignored):
        return taken
    for rel in ignored:
        p = os.path.join(repo, rel)
        if os.path.basename(p) in BUILD and os.path.isdir(p) and not os.path.islink(p) and delete(p, repo, dev, rule, age) is None:
            taken.add(p)
    return taken


def due(name, period):
    """Whether the step name last ran more than period seconds ago, stamping it now if so; a dry run always runs it, unstamped."""
    if DRY:
        return True
    stamp = os.path.join(STATE, f'disk-sweep.{name}')
    try:
        if NOW - os.path.getmtime(stamp) < period:
            return False
    except OSError:
        pass
    open(stamp, 'a').close()
    os.utime(stamp, (NOW, NOW))
    return True


def sweep_home():
    """Once a day, below HOME outside hidden folders and the work folders (sweep_files has those), up to 5 levels down: h-ignored, build
    output unused for 14 days (neither written nor read) in the git repos, then h-cargo, each cargo build folder (CARGO) in a repo or
    not, unused for 7 days, that h-ignored didn't take."""
    if not due('home', DAY):
        return
    dev, stack, taken = os.lstat(HOME).st_dev, [(HOME, 0, False)], set()
    while stack:
        d, depth, in_repo = stack.pop()
        if not in_repo and d != HOME and os.path.lexists(os.path.join(d, '.git')):
            taken |= sweep_repo(d, dev, 'h-ignored', OLD)
            in_repo = True
        if depth == 5:
            continue
        try:
            entries = list(os.scandir(d))
        except OSError:
            continue
        for e in entries:
            if e.name.startswith('.') or d == HOME and e.name.endswith('-work') or not e.is_dir(follow_symlinks=False) or e.stat(follow_symlinks=False).st_dev != dev:
                continue
            if all(os.path.isfile(os.path.join(e.path, f)) for f in CARGO):
                if e.path not in taken:
                    delete(e.path, d, dev, 'h-cargo', WEEK)
            elif e.name not in BUILD:
                stack.append((e.path, depth + 1, in_repo))


CACHES = ('.cargo/registry/cache', '.cargo/git/checkouts', '.cache/node-gyp', '.cache/typescript', '.cache/yarn', '.cache/go-build')  # named tool caches only: other ~/.cache folders hold drafts and records, and browser binaries
# (ms-playwright, puppeteer, electron) and installed hook environments (pre-commit) stay too; each entry goes after 14 days unwritten and unread


def run_tool(*argv):
    """A package manager's own cache command, logged as k-cache tool:<name>; a missing tool is skipped. authorized() first."""
    if not shutil.which(argv[0]):
        return
    if not DRY:
        authorized(HOME)
        r = subprocess.run(argv, capture_output=True, text=True)
        if r.returncode:
            print(f'disk-sweep: {" ".join(argv)} exited {r.returncode}: {r.stderr.strip()}', file=sys.stderr)
            return
    record('?', f'tool:{argv[0]}', 'k-cache', 'deleted')


def sweep_caches():
    """Once a day, k-cache: pnpm's and pip's own cache commands, npm's when ~/.npm/_cacache is unused for 14 days (neither written nor read), and each
    entry of CACHES unused for 14 days (neither written nor read) that isn't busy (a cargo git checkout may hold .git: cargo rebuilds it from its db)."""
    if not due('caches', DAY):
        return
    try:
        run_tool('pnpm', 'store', 'prune')
        cacache = os.path.join(HOME, '.npm', '_cacache')
        if os.path.isdir(cacache) and not changed(cacache, lambda rel: False, OLD):
            run_tool('npm', 'cache', 'clean', '--force')
        run_tool('pip', 'cache', 'purge')
    except PermissionError as e:
        print(f'{e}: package caches skipped', file=sys.stderr)
    for rel in CACHES:
        top = os.path.join(HOME, rel)
        if os.path.islink(top) or not os.path.isdir(top):
            continue
        dev = os.lstat(top).st_dev
        for e in sorted(os.scandir(top), key=lambda e: e.name):
            if e.is_dir(follow_symlinks=False):
                delete(e.path, e.path, dev, 'k-cache', OLD, vcs=rel != '.cargo/git/checkouts')


def report():
    """Weekly, never a deletion: ~/.mergeworthy/disk-report.md lists the 20 largest folders under HOME with no file changed in
    14 days that no rule deletes (build folders, CACHES and ~/.npm/_cacache left out), for the user to pick from."""
    if not due('report', 7 * DAY):
        return
    skip, dev, found = {os.path.join(HOME, c) for c in CACHES + ('.npm/_cacache',)}, os.lstat(HOME).st_dev, []

    def walk_size(d):
        """(bytes, newest mtime) of d without the skipped folders; adds each stale folder whose parent isn't stale to found."""
        total, newest, stale = 0, 0, []
        try:
            entries = list(os.scandir(d))
        except OSError:
            return 0, NOW
        for e in entries:
            st = e.stat(follow_symlinks=False)
            if st.st_dev != dev or e.path in skip or e.name in BUILD:
                continue
            if e.is_dir(follow_symlinks=False):
                b, n = walk_size(e.path)
                if n < NOW - OLD:
                    stale.append((b, e.path))
            else:
                b, n = st.st_blocks * 512, max(st.st_mtime, st.st_atime)
            total, newest = total + b, max(newest, n)
        if newest >= NOW - OLD or d == HOME:
            found.extend(stale)
        return total, newest

    walk_size(HOME)
    rows = [f'| {b / 1e9:.2f} GB | {p} |' for b, p in sorted(found, reverse=True)[:20]]
    with open(os.path.join(STATE, 'disk-report.md'), 'w') as f:
        f.write('# Folders under the home folder unused for 14 days (neither written nor read) that no disk-sweep rule deletes\n\n| Size | Folder |\n|---|---|\n'
                + '\n'.join(rows) + '\n')


PRUNES = (('image', '-a'), ('builder',))  # no containers: until= selects one created long ago even if it stopped a minute ago


def prune_docker():
    """d-docker; 1 when a prune fails, else 0. A dry run lists the prunes without calling Docker; a deleting run prunes only
    when the watcher daemon of the main watch dir started it, since the machine's Docker is shared with every test and probe."""
    if not shutil.which('docker'):
        return 0
    if DRY:
        for what, *_ in PRUNES + (('builder',),):
            record('?', f'docker:{what}', 'd-docker', 'deleted')
        return 0
    try:
        if run_docker('version', timeout=60).returncode:
            return 0
    except PermissionError as e:
        print(f'{e}: Docker skipped', file=sys.stderr)
        return 0
    except subprocess.TimeoutExpired:
        return 0
    failed = 0
    for what, *every in PRUNES:
        r = run_docker(what, 'prune', *every, '-f', '--filter', 'until=336h')
        if r.returncode:
            print(f'disk-sweep: docker {what} prune exited {r.returncode}: {r.stderr.strip()}', file=sys.stderr)
            failed = 1
            continue
        reclaimed(r, what)
    if not failed:
        failed = cap_builder()
    return failed


def reclaimed(r, what):
    """Log a Docker prune that succeeded with the size its output reports."""
    m = re.search(r'Total(?: reclaimed space)?:\s*([\d.]+)\s*([kKMGT]?)B', r.stdout)
    record(int(float(m[1]) * 1000 ** ' KMGT'.index(m[2].upper() or ' ')) if m else 0, f'docker:{what}', 'd-docker', 'deleted')


def cap_builder():
    """Prune Docker's build cache down to a tenth of the filesystem holding Docker's root dir; 1 when that fails, else 0. buildx names
    the cap --max-used-space, the classic builder --keep-storage."""
    root = run_docker('info', '--format', '{{.DockerRootDir}}').stdout.strip()
    try:
        st = os.statvfs(root)
    except OSError as e:
        print(f'disk-sweep: Docker root dir {root!r}: {e}', file=sys.stderr)
        return 1
    flag = '--max-used-space' if '--max-used-space' in run_docker('builder', 'prune', '--help').stdout else '--keep-storage'
    r = run_docker('builder', 'prune', '-f', flag, str(st.f_blocks * st.f_frsize // 10))
    if r.returncode:
        print(f'disk-sweep: docker builder prune {flag} exited {r.returncode}: {r.stderr.strip()}', file=sys.stderr)
        return 1
    reclaimed(r, 'builder')
    return 0


def run_docker(*args, timeout=None):
    """docker <args>, captured, once authorized() allows a Docker command."""
    authorized()
    return subprocess.run(['docker', *args], capture_output=True, text=True, timeout=timeout)


def main():
    global DRY
    if sys.argv[1:] not in ([], ['--delete']):
        sys.exit('usage: disk-sweep [--delete]')
    DRY = sys.argv[1:] != ['--delete']
    home = os.path.realpath(HOME)
    if not DRY and (inside(home, ACCOUNT_HOME) or inside(ACCOUNT_HOME, home)) and not from_daemon(INSTALLED, main_watch_dir()):
        print(f'disk-sweep: --delete under {ACCOUNT_HOME} runs only from the watcher daemon of the main watch dir', file=sys.stderr)
        sys.exit(2)
    os.makedirs(STATE, exist_ok=True)
    lock = open(os.path.join(STATE, 'disk-sweep.lock'), 'a')
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        sys.exit('disk-sweep: another sweep is running')
    sweep_work()
    sweep_steward()
    sweep_files()
    sweep_home()
    sweep_caches()
    report()
    sys.exit(prune_docker())


if __name__ == '__main__':
    main()
