#!/bin/sh
# Every check CI runs, before the push leaves: a red tests/all.sh blocks it (enable with `git config core.hooksPath .githooks`)
cd "$(git rev-parse --show-toplevel)" && bash tests/all.sh . >/tmp/mergeworthy-pre-push.log 2>&1 || { echo "pre-push: tests/all.sh failed, see /tmp/mergeworthy-pre-push.log"; exit 1; }
