{
  "mergeworthy": {
    "SessionStart": [{"type": "command", "command": "python3 ../hooks/agy.py SessionStart", "timeout": 600}],
    "PreToolUse": [
      {
        "matcher": "^(run_command|write_file|edit_file|swarm|mcp_.*(delegate_task|t3_thread_launch|create_threads))$",
        "hooks": [{"type": "command", "command": "python3 ../hooks/agy.py PreToolUse", "timeout": 600}]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(run_command|mcp_.*delegate_task)$",
        "hooks": [{"type": "command", "command": "python3 ../hooks/agy.py PostToolUse", "timeout": 600}]
      }
    ],
    "Stop": [{"type": "command", "command": "python3 ../hooks/agy.py Stop", "timeout": 600}]
  }
}
